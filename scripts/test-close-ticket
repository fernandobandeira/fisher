#!/usr/bin/env python3
"""Exercise the close wrapper with local Git repositories and a stand-in bd."""

import os
from pathlib import Path
import subprocess
import tempfile
import unittest


WRAPPER = Path(__file__).resolve().with_name("close-ticket")


def todo(ticket, description):
    return f"// TODO({ticket}): {description}\n"


class CloseTicket(unittest.TestCase):
    def setUp(self):
        workspace = tempfile.TemporaryDirectory()
        self.addCleanup(workspace.cleanup)
        root = Path(workspace.name)
        self.origin = root / "origin"
        self.checkout = root / "checkout"
        self.calls = root / "bd-calls"
        self.env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
        self.env.update(
            GIT_CONFIG_GLOBAL=os.devnull,
            GIT_CONFIG_NOSYSTEM="1",
            GIT_TEMPLATE_DIR="",
            GIT_ALLOW_PROTOCOL="file",
            PATH=f"{root}{os.pathsep}{self.env['PATH']}",
            FIXTURE_BD_CALLS=str(self.calls),
        )
        stub = root / "bd"
        stub.write_text('#!/bin/sh\nprintf "%s\\n" "$@" >>"$FIXTURE_BD_CALLS"\n')
        stub.chmod(0o755)

        self.git(root, "init", "-q", "-b", "main", str(self.origin))
        (self.origin / "example.rs").write_text("// Deferred work fixtures\n")
        self.commit_origin()
        self.git(root, "clone", "-q", str(self.origin), str(self.checkout))
        self.subdir = self.checkout / "other"
        self.subdir.mkdir()

        # Only the newly fetched main contains these TODOs.
        (self.origin / "example.rs").write_text(
            todo("fisher-abc.1", "Child work")
            + todo("fisher-abcd", "Separate work")
            + todo("fisher-abc.1", "More child work")
            + todo("fisher-abcx1", "Other work")
        )
        self.commit_origin()

    def git(self, cwd, *args):
        return subprocess.run(
            ["git", *args], cwd=cwd, env=self.env, check=True, text=True, capture_output=True,
        )

    def commit_origin(self):
        self.git(self.origin, "add", "example.rs")
        self.git(
            self.origin,
            "-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid",
            "commit", "-qm", "Deferred work fixtures",
        )

    def close(self, ticket, *args):
        return subprocess.run(
            [str(WRAPPER), ticket, *args], cwd=self.subdir, env=self.env,
            text=True, capture_output=True,
        )

    def test_refuses_and_lists_all_matches_from_fetched_main(self):
        result = self.close("fisher-abc.1")
        self.assertNotEqual(result.returncode, 0)
        self.assertIn("example.rs:1:" + todo("fisher-abc.1", "Child work"), result.stderr)
        self.assertIn("example.rs:3:" + todo("fisher-abc.1", "More child work"), result.stderr)
        self.assertNotIn(todo("fisher-abcd", "Separate work"), result.stderr)
        self.assertNotIn(todo("fisher-abcx1", "Other work"), result.stderr)
        self.assertFalse(self.calls.exists())

    def test_child_and_longer_id_do_not_block_parent(self):
        result = self.close("fisher-abc", "--reason", "Parent work is complete")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(
            self.calls.read_text().splitlines(),
            ["close", "fisher-abc", "--reason", "Parent work is complete"],
        )

    def test_ticket_without_a_todo_on_main_closes(self):
        (self.checkout / "example.rs").write_text(todo("fisher-free", "Local only"))
        result = self.close("fisher-free")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(self.calls.read_text().splitlines(), ["close", "fisher-free"])

    def test_fetch_failure_blocks_closure_with_a_cached_main(self):
        self.git(self.checkout, "remote", "set-url", "origin", str(self.origin / "missing"))
        result = self.close("fisher-free")
        self.assertNotEqual(result.returncode, 0)
        self.assertIn("could not fetch main from origin", result.stderr)
        self.assertFalse(self.calls.exists())


if __name__ == "__main__":
    unittest.main(verbosity=2)
