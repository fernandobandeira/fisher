#!/usr/bin/env python3
"""Wait for a pull request into main and update its branch when it falls behind."""

import argparse
import json
import math
import re
import subprocess
import sys
import time


# The Actions jobs named in the main gates ruleset.
REQUIRED_CHECKS = {"check", "mutation", "coverage", "guard-change"}
FAILED_CONCLUSIONS = {"FAILURE", "CANCELLED", "TIMED_OUT"}
UNSTARTED = "0001-01-01T00:00:00Z"


def gh(deadline, *args, stderr=None):
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise subprocess.TimeoutExpired(args, 0)
    return subprocess.check_output(
        ("gh", *args), timeout=remaining, text=True, stderr=stderr,
    ).strip()


def read_gh(deadline, parse, *args, retry=True):
    try:
        return parse(gh(deadline, *args, stderr=subprocess.PIPE))
    except (OSError, subprocess.CalledProcessError, ValueError) as error:
        stderr = error.stderr if isinstance(error, subprocess.CalledProcessError) else None
        detail = " ".join((stderr or "").strip().splitlines()) or str(error)
        message = f"could not read from gh {' '.join(args[:2])}: {detail}"
        if not retry:
            sys.exit(message)
        print(f"Warning: {message}", file=sys.stderr)
        return None


def check_order(check):
    started = check["startedAt"]
    status = check["status"]
    unstarted = started == UNSTARTED and status != "COMPLETED"
    # Actions uses /job/ for a started job and /runs/ for a queued job.
    url = check.get("detailsUrl") or ""
    if not isinstance(url, str):
        raise ValueError("unexpected check details URL")
    job = re.search(r"/(?:job|runs)/([0-9]+)(?:[?#].*)?$", url)
    job_id = int(job[1]) if job else 0
    # Keep the result independent of list order even if a job URL is absent.
    return unstarted, started, job_id, status, check["conclusion"]


def parse_pull(output):
    pull = json.loads(output)
    if not isinstance(pull, dict) or any(
        not isinstance(pull.get(key), str)
        for key in ("state", "mergeStateStatus", "mergeable", "baseRefName", "headRefOid")
    ) or not isinstance(pull.get("isDraft"), bool):
        raise ValueError("unexpected pull request fields")

    # The rollup is scoped to the current head. Only Actions jobs are required.
    checks = pull.get("statusCheckRollup")
    if checks is None:
        checks = []
    if not isinstance(checks, list) or any(not isinstance(check, dict) for check in checks):
        raise ValueError("unexpected check rollup")
    latest = {}
    for check in checks:
        name = check.get("name")
        if check.get("__typename") != "CheckRun" or not isinstance(name, str):
            continue
        if name not in REQUIRED_CHECKS:
            continue
        if any(not isinstance(check.get(key), str) for key in ("startedAt", "status", "conclusion")):
            raise ValueError(f"unexpected fields for check {name}")
        if name not in latest or check_order(check) > check_order(latest[name]):
            latest[name] = check
    return pull, latest


def parse_base(output):
    if not re.fullmatch("[0-9a-f]{40}", output):
        raise ValueError("expected the SHA of main")
    return output


def await_merge(number, timeout, interval):
    deadline = time.monotonic() + timeout
    updated_bases = set()
    updated_head = None
    last_state = None
    delay = 0
    try:
        while time.monotonic() < deadline:
            if delay:
                time.sleep(max(0, min(delay, deadline - time.monotonic())))
            delay = interval
            result = read_gh(
                deadline, parse_pull, "pr", "view", number, "--json",
                "state,mergeStateStatus,mergeable,baseRefName,headRefOid,statusCheckRollup,isDraft",
                retry=last_state is not None,
            )
            if result is None:
                continue
            pull, checks = result
            state, merge_state = pull["state"], pull["mergeStateStatus"]
            head = pull["headRefOid"]
            last_state = f"{state}/{merge_state} at {head}"
            if state == "MERGED":
                print(f"Pull request #{number} merged.")
                return
            if state == "CLOSED":
                sys.exit(f"Pull request #{number} closed without merging.")
            if pull["isDraft"]:
                sys.exit(f"Pull request #{number} is a draft.")
            if pull["baseRefName"] != "main":
                sys.exit(f"Pull request #{number} must target main.")
            if pull["mergeable"] == "CONFLICTING":
                sys.exit(f"Pull request #{number} conflicts with main. Rebase is needed.")

            # GitHub may still show the old head while an update is being applied.
            if head != updated_head:
                for name, check in checks.items():
                    if (check["status"] == "COMPLETED"
                            and check["conclusion"] in FAILED_CONCLUSIONS):
                        sys.exit(
                            f"Pull request #{number} required check {name} "
                            f"finished with {check['conclusion']} at {head}."
                        )
            if merge_state == "BEHIND":
                base = read_gh(deadline, parse_base, "api",
                               "repos/{owner}/{repo}/git/ref/heads/main", "--jq", ".object.sha")
                if base is not None and base not in updated_bases:
                    print(f"Updating pull request #{number} against main at {base}.", flush=True)
                    gh(deadline, "pr", "update-branch", number)
                    updated_bases.add(base)
                    updated_head = head
    except subprocess.TimeoutExpired:
        pass
    except (OSError, subprocess.CalledProcessError) as error:
        sys.exit(f"Could not wait for pull request #{number}: {error}")

    last_state = last_state or "no pull request state received"
    sys.exit(f"Timed out waiting for pull request #{number}. Last state: {last_state}.")


def positive_seconds(value):
    seconds = float(value)
    if not math.isfinite(seconds) or seconds <= 0:
        raise argparse.ArgumentTypeError("expected a positive number of seconds")
    return seconds


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("number", type=int, help="pull request number in this repository")
    parser.add_argument("--timeout", type=positive_seconds, default=3600,
                        help="time limit in seconds (default: 3600)")
    parser.add_argument("--interval", type=positive_seconds, default=15,
                        help="seconds between polls (default: 15)")
    args = parser.parse_args()
    if args.number <= 0:
        parser.error("pull request number must be positive")
    await_merge(str(args.number), args.timeout, args.interval)


if __name__ == "__main__":
    main()
