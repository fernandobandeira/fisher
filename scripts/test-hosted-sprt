#!/usr/bin/env python3
"""Exercise hosted planning, joining, provenance and records without playing."""

import argparse
from contextlib import redirect_stderr, redirect_stdout
from io import StringIO
import json
import os
from pathlib import Path
from runpy import run_path
from subprocess import CompletedProcess
import sys
from tempfile import TemporaryDirectory
import unittest
from unittest.mock import Mock, patch

sys.dont_write_bytecode = True

from clocked_sprt import ROOT, Pair, print_report


hosted = run_path(str(ROOT / "scripts/hosted-sprt"))["record_run"].__globals__
fixtures = ROOT / "scripts/clocked-sprt-fixtures"


def report(pairs, status=0, result=None):
    with redirect_stdout(StringIO()) as output:
        print(f"Result: {result or print_report(pairs, 'gain')}")
    return CompletedProcess([], status, output.getvalue(), "")


class HostedSprt(unittest.TestCase):
    def setUp(self):
        temporary = TemporaryDirectory()
        self.addCleanup(temporary.cleanup)
        self.directory = Path(temporary.name)
        self.source = self.directory / "source"
        self.source.mkdir()
        self.plan = {
            "run": "123", "date": "2026-11-27", "measured": "a" * 40, "opponent": "b" * 40,
            "test": "gain", "first": 1, "count": 2, "opponent_view": False,
            "source_run": "", "replay": False, "prior_runs": [],
        }

    def test_split(self):
        self.assertEqual(
            [{"first": 10, "count": 1}, {"first": 11, "count": 1}],
            list(hosted["ranges"](10, 2)),
        )
        ranges = list(hosted["ranges"](20, 1001))
        self.assertEqual(9, len(ranges))
        self.assertEqual(1001, sum(shard["count"] for shard in ranges))
        self.assertLessEqual(max(shard["count"] for shard in ranges), 125)
        self.assertEqual(
            [20, *[shard["first"] + shard["count"] for shard in ranges[:-1]]],
            [shard["first"] for shard in ranges],
        )

    def test_join_orders_ranges_and_keeps_bad_games(self):
        first = self.directory / "sprt-2-1"
        first.mkdir()
        (first / "openings.epd").write_text("first\nsecond\n")
        (first / "games.pgn").write_text(
            '[Event "Game"]\n[FEN "second"]\n\n0-1\n\n'
            '[Event "Game"]\n[FEN "first"]\n\n1-0\n'
        )
        last = self.directory / "sprt-2-4"
        last.mkdir()
        (last / "openings.epd").write_text("fourth\n")
        (last / "games.pgn").write_bytes(b"Damaged PGN\xff")
        (self.directory / "sprt-1-3").mkdir()
        (self.directory / "sprt-1-3/games.pgn").write_text("From an earlier attempt")
        joined = hosted["join_ranges"](self.directory, [
            {"first": 1, "count": 2}, {"first": 3, "count": 1}, {"first": 4, "count": 1},
        ], "2")
        self.assertLess(joined.index(b'"first"'), joined.index(b'"second"'))
        self.assertTrue(joined.endswith(b"Damaged PGN\xff"))
        self.assertNotIn(b"earlier attempt", joined)

    def test_record_fields_and_statuses(self):
        won = Pair(4, ("loss on time", "normal"))
        lost = Pair(0, ("normal", "normal"))
        mixed = [
            won if n * 5072 // 10000 > (n - 1) * 5072 // 10000 else lost
            for n in range(1, 10001)
        ]
        for expected, verdict in (
            ("pass", report([won] * 600)),
            ("fail", report([lost] * 600)),
            ("inconclusive", report(mixed)),
            ("no verdict yet", report([won])),
            ("void", report([], 1, "void (Missing game at opening 1)")),
        ):
            with self.subTest(expected=expected):
                fields = hosted["report_fields"](verdict)
                self.assertEqual(expected, fields[-2])
                if expected == "pass":
                    self.assertEqual(600, fields[4])
                if expected == "void":
                    self.assertEqual("Missing game at opening 1", fields[-1])
        for status in (2, 3):
            with self.assertRaisesRegex(ValueError, f"status {status}"):
                hosted["report_fields"](CompletedProcess([], status, "", ""))

    def test_continuation_checks_the_prefix_and_keeps_lineage(self):
        prior = dict(self.plan, run="122", first=2, count=1, prior_runs=["121"])
        (self.source / "plan.json").write_text(json.dumps(prior))
        plan = dict(self.plan, source_run="122", first=3)
        scratch = self.directory / "replay"
        with patch.dict(hosted, judge=Mock(return_value=report([Pair(2, ("normal", "normal"))]))):
            with redirect_stderr(StringIO()):
                self.assertEqual(["121", "122"], hosted["prior_runs"](plan, self.source, scratch))
            hosted["judge"].assert_called_once_with(plan, self.source / "games.pgn", 1, 2, scratch)
        with patch.dict(hosted, judge=lambda *args: report([Pair(4, ("normal", "normal"))] * 600)):
            with redirect_stderr(StringIO()), self.assertRaisesRegex(ValueError, "no verdict yet"):
                hosted["prior_runs"](plan, self.source, scratch)

    def test_record_replays_joined_range_and_keeps_cumulative_pgn(self):
        (self.source / "games.pgn").write_bytes(b"Earlier games")
        plan = dict(self.plan, first=3, count=1, prior_runs=["122"], ranges=[{"first": 3, "count": 1}])
        shard = self.directory / "sprt-1-3"
        shard.mkdir()
        current = (fixtures / "crash.pgn").read_bytes()
        (shard / "games.pgn").write_bytes(current)
        target = self.directory / "record"
        args = argparse.Namespace(plan=json.dumps(plan), source=self.source, shards=self.directory, output=target)
        judge = Mock(return_value=report([], 1, "void (fixture)"))
        environment = {
            "GITHUB_RUN_ATTEMPT": "1", "GITHUB_SERVER_URL": "https://github.com",
            "GITHUB_REPOSITORY": "owner/fisher",
        }
        with patch.dict(hosted, judge=judge), patch.dict(os.environ, environment), redirect_stdout(StringIO()):
            hosted["record_run"](args)
        judge.assert_called_once_with(plan, target / "range.pgn", 3, 1, target / "judge", self.source / "games.pgn")
        self.assertEqual(current, (target / "range.pgn").read_bytes())
        self.assertEqual(b"Earlier games\n\n" + current, (target / "games.pgn").read_bytes())
        self.assertIn("\tvoid\tfixture\t122\thttps://github.com/owner/fisher/actions/runs/123\n",
                      (target / "record.tsv").read_text())


if __name__ == "__main__":
    unittest.main()
