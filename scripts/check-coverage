#!/usr/bin/env python3
"""Check LLVM region coverage against each crate's reviewed floor."""

import argparse
from collections import defaultdict
from decimal import Decimal, InvalidOperation
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
VERSION = "0.9.2"


def region_counts(report, root):
    totals = defaultdict(lambda: (0, 0))
    for unit in report["data"]:
        for source in unit["files"]:
            path = Path(source["filename"])
            if path.is_absolute():
                if not path.is_relative_to(root):
                    continue
                path = path.relative_to(root)
            parts = path.parts
            if len(parts) < 4 or parts[0] != "crates" or parts[2] != "src":
                continue
            crate = parts[1]
            regions = source["summary"]["regions"]
            covered, count = totals[crate]
            totals[crate] = covered + regions["covered"], count + regions["count"]
    return totals


def compare(totals, floors, crates):
    summaries = []
    problems = []

    for crate in sorted(crates - floors.keys()):
        problems.append(f"{crate}: measure region coverage and add its floor to .cargo/coverage-floors.json.")
    for crate in sorted(floors.keys() - crates):
        problems.append(f"{crate}: remove the stale floor from .cargo/coverage-floors.json.")
    for crate in sorted(crates & floors.keys()):
        covered, count = totals.get(crate, (0, 0))
        floor = Decimal(floors[crate])
        if not 0 <= floor <= 100 or floor * 2 != (floor * 2).to_integral_value():
            problems.append(f"{crate}: set a floor from 0% to 100% in half-point increments.")
            continue
        if not 0 <= covered <= count or count == 0:
            problems.append(
                f"{crate}: LLVM reported no usable regions. Run scripts/check-coverage with the workspace tests."
            )
            continue

        measured = Decimal(100 * covered) / count
        summary = f"{crate}: {measured:.3f}% ({covered}/{count} regions), floor {floor}%"
        summaries.append(summary)
        if 100 * covered < floor * count:
            problems.append(
                f"{summary}. Restore coverage with tests. See regions with "
                "`cargo llvm-cov report --locked --workspace --text`."
            )
    return summaries, problems


def self_test():
    def source(path, covered, count):
        return {"filename": path, "summary": {"regions": {"covered": covered, "count": count}}}

    root = Path("/work")
    report = {"data": [{"files": [
        source("/work/crates/rules/src/lib.rs", 2, 2),
        source("/work/crates/rules/src/fen.rs", 97, 98),
        source("/work/crates/search/src/lib.rs", 1000, 1000),
        source("/work/crates/rules/tests/rules.rs", 80, 80),
        source("/other/crates/rules/src/lib.rs", 90, 90),
    ]}]}
    totals = region_counts(report, root)
    assert totals == {"rules": (99, 100), "search": (1000, 1000)}
    floors = {"rules": Decimal("99.5"), "search": 100}
    summaries, problems = compare(totals, floors, set(floors))
    assert len(summaries) == 2
    assert len(problems) == 1 and problems[0].startswith("rules: 99.000%")
    assert "cargo llvm-cov report" in problems[0]

    # Equality passes, while a missing report or an unregistered crate fails.
    floors["rules"] = 99
    assert not compare(totals, floors, set(floors))[1]
    assert "no usable regions" in compare({}, floors, set(floors))[1][0]
    assert "add its floor" in compare(totals, floors, set(floors) | {"bench"})[1][0]
    assert "remove the stale floor" in compare(totals, floors, {"rules"})[1][0]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--self-test", action="store_true")
    if parser.parse_args().self_test:
        self_test()
        return 0

    install = (
        f"Install cargo-llvm-cov with `cargo install cargo-llvm-cov --version {VERSION} --locked` "
        "and LLVM tools with `rustup component add llvm-tools`."
    )
    try:
        version = subprocess.run(
            ["cargo", "llvm-cov", "--version"], cwd=ROOT, capture_output=True, text=True
        )
        if version.returncode or version.stdout.strip() != f"cargo-llvm-cov {VERSION}":
            print(install, file=sys.stderr)
            return 1
        floors = json.loads((ROOT / ".cargo/coverage-floors.json").read_text(), parse_float=Decimal)
        crates = {manifest.parent.name for manifest in (ROOT / "crates").glob("*/Cargo.toml")}
        report = subprocess.check_output(
            ["cargo", "llvm-cov", "--locked", "--workspace", "--json", "--summary-only"],
            cwd=ROOT,
        )
        summaries, problems = compare(region_counts(json.loads(report), ROOT), floors, crates)
    except (OSError, subprocess.CalledProcessError, ValueError, KeyError, InvalidOperation) as error:
        print(f"Could not check region coverage: {error}. {install}", file=sys.stderr)
        return 1

    for summary in summaries:
        print(summary)
    for problem in problems:
        print(problem, file=sys.stderr)
    return int(bool(problems))


if __name__ == "__main__":
    sys.exit(main())
