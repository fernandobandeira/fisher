#!/usr/bin/env python3
"""Run cargo-mutants and check survivors against reviewed equivalents."""

import argparse
from collections import Counter, defaultdict
from hashlib import sha256
import json
import re
from pathlib import Path
import subprocess
import sys
from tempfile import TemporaryDirectory, mkdtemp

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ".cargo/mutation-gate.json"
VERSION = "27.1.0"
OUTCOMES = {
    "CaughtMutant": "caught",
    "Unviable": "unviable",
    "MissedMutant": "surviving",
    "Timeout": "timeout",
}


def key(mutant, site):
    return mutant["file"], mutant["function"], mutant["replacement"], tuple(site)


def reviewed_entries(entries):
    reviewed = {}
    for entry in entries:
        identity = key(entry, entry["site"])
        if identity in reviewed or not entry["proof"].strip() or not identity[-1]:
            raise ValueError(f"Give each equivalent mutant one distinct site and a proof: {identity}")
        digest = entry["function_sha256"]
        if not re.fullmatch(r"[0-9a-f]{64}", digest):
            raise ValueError(f"Record the SHA-256 of the reviewed function: {identity}")
        reviewed[identity] = digest
    return reviewed


def mutation_site(diff):
    # Ignore hunk coordinates and unchanged context. Keep the mutation marker so
    # two replacements on the same source line can still be distinguished.
    return tuple(
        line[0] + line[1:].strip()
        for line in diff.splitlines()[2:]
        if line.startswith(("-", "+"))
    )


def function_digest(source, span):
    # Cargo-mutants reports one-based character positions and an exclusive end.
    lines = source.split("\n")
    start, end = span["start"], span["end"]
    first, last = start["line"] - 1, end["line"] - 1
    begin, limit = start["column"] - 1, end["column"] - 1
    if first == last:
        function = lines[first][begin:limit]
    else:
        function = "\n".join([lines[first][begin:], *lines[first + 1:last], lines[last][:limit]])
    return sha256(function.encode("utf-8")).hexdigest()


def reconcile(results, reviewed, log_directory="mutants.out/log"):
    counts = defaultdict(Counter)
    seen = Counter()
    listed_survivors = set()
    changed_functions = set()
    problems = []
    for mutant, outcome, site in results:
        identity = key(mutant, site)
        seen[identity] += 1
        crate = mutant["package"]
        if (outcome == "surviving" and identity in reviewed
                and mutant["function_sha256"] == reviewed[identity]):
            counts[crate]["equivalent"] += 1
            listed_survivors.add(identity)
            continue
        counts[crate][outcome] += 1
        if outcome == "timeout":
            problems.append(
                f"{mutant['name']} timed out. Inspect its log in {log_directory} "
                "and add a test that rejects the mutation without hanging."
            )
        if outcome != "surviving":
            continue
        if identity in reviewed:
            changed_functions.add(identity)
            problems.append(
                f"{mutant['name']} survived after its enclosing function changed. "
                f"Review its proof in {CONFIG} before updating the digest "
                f"({mutant['function_sha256']}), or add a test that catches it."
            )
        else:
            problems.append(
                f"{mutant['name']} survived. Add a test that catches it, or propose a proof "
                f"of equivalence in {CONFIG}.\n  Site: {json.dumps(site)}"
            )
    for identity in listed_survivors:
        if seen[identity] != 1:
            problems.append(f"Ambiguous equivalent mutant {identity}. Give it a distinct site.")
    for identity in reviewed.keys() - listed_survivors:
        if identity not in seen:
            problems.append(f"Reviewed mutant {identity} no longer exists. Update {CONFIG}.")
        elif identity not in changed_functions:
            problems.append(f"Reviewed mutant {identity} no longer survives. Update {CONFIG}.")
    return counts, sorted(problems)


def verify_mutants(expected, actual, label):
    # The full report identity includes spans and diffs. The reviewed-equivalent
    # key ignores coordinates so proofs can survive unrelated edits.
    expected = Counter(json.dumps(mutant, sort_keys=True) for mutant in expected)
    actual = Counter(json.dumps(mutant, sort_keys=True) for mutant in actual)
    duplicates = [json.loads(mutant)["name"] for mutant, count in actual.items() if count > 1]
    missing = [json.loads(mutant)["name"] for mutant in expected - actual]
    unexpected = [json.loads(mutant)["name"] for mutant in actual - expected]
    if duplicates or missing or unexpected:
        raise ValueError(
            f"{label}: duplicate mutants {duplicates}, missing mutants {missing}, "
            f"unexpected mutants {unexpected}"
        )


def read_results(output):
    planned = json.loads((output / "mutants.json").read_text())
    report = json.loads((output / "outcomes.json").read_text())
    if not report["end_time"]:
        raise ValueError(f"Mutation report is incomplete: {output}")
    baselines = []
    results = []
    for item in report["outcomes"]:
        if item["scenario"] == "Baseline":
            baselines.append(item["summary"])
            continue
        diff = (output / item["diff_path"]).read_text()
        mutant = {**item["scenario"]["Mutant"], "diff": diff}
        results.append((mutant, OUTCOMES[item["summary"]]))
    if baselines != ["Success"]:
        raise ValueError(f"Mutation report has no successful baseline: {output}")
    verify_mutants(planned, (mutant for mutant, _ in results), output)
    return results


def merge_parts(directory, parts, expected):
    paths = [directory / f"mutation-part-{part}" for part in range(parts)]
    missing = [path.name for path in paths if not path.is_dir()]
    if missing:
        raise ValueError(f"Missing mutation parts: {', '.join(missing)}")
    unexpected = sorted(path.name for path in set(directory.glob("mutation-part-*")) - set(paths))
    if unexpected:
        raise ValueError(f"Unexpected mutation parts: {', '.join(unexpected)}")
    results = [result for path in paths for result in read_results(path)]
    verify_mutants(expected, (mutant for mutant, _ in results), "Whole workspace")
    print(f"Verified {len(results)} mutants across {parts} parts against the unsplit list.")
    return results


def reviewed_results(results):
    for mutant, outcome in results:
        function = mutant["function"]
        digest = (
            function_digest((ROOT / mutant["file"]).read_bytes().decode("utf-8"), function["span"])
            if function else None
        )
        yield {
            **mutant,
            "function": function["function_name"] if function else None,
            "function_sha256": digest,
        }, outcome, mutation_site(mutant["diff"])


def test_merge_parts():
    def write_part(path, mutant):
        path.mkdir(exist_ok=True)
        (path / "mutants.json").write_text(json.dumps([{**mutant, "diff": "diff\n"}]))
        (path / "change.diff").write_text("diff\n")
        (path / "outcomes.json").write_text(json.dumps({
            "end_time": "finished",
            "outcomes": [
                {"scenario": "Baseline", "summary": "Success"},
                {"scenario": {"Mutant": mutant}, "summary": "CaughtMutant", "diff_path": "change.diff"},
            ],
        }))

    def expect_failure(directory, expected, message):
        try:
            merge_parts(directory, 2, expected)
        except ValueError as error:
            assert message in str(error), error
        else:
            raise AssertionError(f"Expected merge to fail with {message}")

    with TemporaryDirectory() as temporary:
        directory = Path(temporary)
        first, second = {"name": "first mutant"}, {"name": "second mutant"}
        expected = [{**mutant, "diff": "diff\n"} for mutant in (first, second)]
        write_part(directory / "mutation-part-0", first)
        expect_failure(directory, expected, "Missing mutation parts: mutation-part-1")
        write_part(directory / "mutation-part-1", first)
        expect_failure(directory, expected, "duplicate mutants ['first mutant']")
        write_part(directory / "mutation-part-1", second)
        expect_failure(directory, [*expected, {"name": "third mutant"}], "missing mutants ['third mutant']")
        assert [mutant for mutant, _ in merge_parts(directory, 2, expected)] == expected


def self_test():
    source = "fn score(score: i32) -> bool {\n    score != 0 && score > 0\n}"
    span = {"start": {"line": 1, "column": 1}, "end": {"line": 3, "column": 2}}
    digest = function_digest(source, span)
    assert digest == sha256(source.encode()).hexdigest()
    shifted_span = {"start": {"line": 2, "column": 1}, "end": {"line": 4, "column": 2}}
    assert function_digest("// a new comment\n" + source, shifted_span) == digest
    assert function_digest("é fn f() {}", {
        "start": {"line": 1, "column": 3}, "end": {"line": 1, "column": 12},
    }) == sha256(b"fn f() {}").hexdigest()
    changed_digest = function_digest(source.replace("score != 0", "score == 0"), span)

    mutant = {
        "file": "crates/search/src/lib.rs",
        "function": "score",
        "replacement": ">=",
        "package": "search",
        "name": "replace > with >=",
        "function_sha256": digest,
    }
    diff = "--- before\n+++ after\n@@ -10,2 +10,2 @@\n-    score > 0\n+    score >= 0\n"
    site = mutation_site(diff)
    shifted = mutation_site(diff.replace("-10,2 +10,2", "-90,2 +90,2"))
    assert site == shifted == ("-score > 0", "+score >= 0")
    reviewed = reviewed_entries([{**mutant, "site": site, "proof": "Score cannot be zero here."}])

    counts, problems = reconcile([(mutant, "surviving", shifted)], reviewed)
    assert not problems
    assert counts["search"] == {"equivalent": 1}
    stale = {**mutant, "function_sha256": changed_digest}
    assert "function changed" in reconcile([(stale, "surviving", site)], reviewed)[1][0]
    assert "survived" in reconcile([(mutant, "surviving", site)], {})[1][0]
    other = ("-nodes > 0", "+nodes >= 0")
    assert any("survived" in issue for issue in reconcile([(mutant, "surviving", other)], reviewed)[1])
    assert "Ambiguous" in reconcile([(mutant, "surviving", site)] * 2, reviewed)[1][0]
    assert "no longer survives" in reconcile([(mutant, "caught", site)], reviewed)[1][0]
    assert "no longer exists" in reconcile([], reviewed)[1][0]
    assert any("timed out" in problem for problem in
               reconcile([(mutant, "timeout", site)], reviewed)[1])
    test_merge_parts()


def check_version():
    version = subprocess.run(["cargo", "mutants", "--version"], cwd=ROOT, capture_output=True, text=True)
    if version.returncode or version.stdout.strip() != f"cargo-mutants {VERSION}":
        raise ValueError(f"Install cargo-mutants with `cargo install cargo-mutants --version {VERSION} --locked`.")


def mutation_command(jobs):
    return [
        "cargo", "mutants", "--workspace", "--no-config", "--test-workspace=false",
        "--cap-lints=true", "--minimum-test-timeout", "300", "--annotations=none",
        "--copy-target=false", "--cargo-arg=--locked", "--cargo-test-arg=--tests",
        "--jobs", str(jobs),
    ]


def run_mutants(args):
    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=True)
    if args.shard is None:
        output = Path(mkdtemp(prefix="run-", dir=output))
    print(f"Mutation reports: {output}", flush=True)
    command = [*mutation_command(args.jobs), "--output", str(output)]
    if args.shard is not None:
        command.extend(["--shard", args.shard, "--sharding", "round-robin"])
    status = subprocess.run(command, cwd=ROOT).returncode
    if status not in {0, 2, 3}:
        raise ValueError(
            f"cargo-mutants exited {status}. Fix the error above and rerun scripts/check-mutants."
        )

    report = output / "mutants.out"
    results = read_results(report)
    if not results:
        raise ValueError("Mutation results are empty. Rerun scripts/check-mutants.")
    if status == 3 and not any(outcome == "timeout" for _, outcome in results):
        raise ValueError(f"cargo-mutants reported a timeout. Inspect {report / 'log'}.")
    return report, results


def check_results(results, log_directory):
    config = json.loads((ROOT / CONFIG).read_text())
    reviewed = reviewed_entries(config["equivalent"])
    counts, problems = reconcile(reviewed_results(results), reviewed, log_directory)
    for crate in sorted(counts):
        summary = ", ".join(f"{counts[crate][name]} {name}" for name in
                            ("caught", "unviable", "surviving", "equivalent", "timeout"))
        print(f"{crate}: {summary}")
    for problem in problems:
        print(problem, file=sys.stderr)
    return int(bool(problems))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--jobs", type=int, default=4)
    parser.add_argument("--output", type=Path, default=ROOT / "target/mutation")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--self-test", action="store_true")
    mode.add_argument("--shard", help="Test one zero-based k/n shard and write its report to --output")
    mode.add_argument("--merge", type=Path, help="Reconcile the downloaded mutation parts in this directory")
    parser.add_argument("--parts", type=int, help="Number of parts expected by --merge")
    args = parser.parse_args()
    if (args.merge is not None) != (args.parts is not None) or (args.parts is not None and args.parts < 1):
        parser.error("--merge requires a positive --parts, and --parts requires --merge")
    if args.self_test:
        self_test()
        return 0
    try:
        check_version()
        if args.merge is not None:
            expected = json.loads(subprocess.check_output(
                [*mutation_command(args.jobs), "--list", "--json"], cwd=ROOT,
            ))
            if not expected:
                raise ValueError("The whole-workspace mutant list is empty.")
            results = merge_parts(args.merge, args.parts, expected)
            return check_results(results, "the mutation-part artifacts under log/")
        report, results = run_mutants(args)
        if args.shard is not None:
            return 0
        return check_results(results, report / "log")
    except (OSError, subprocess.CalledProcessError, ValueError, KeyError) as error:
        print(f"Could not check mutants: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
