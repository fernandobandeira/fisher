#!/bin/sh
# Play the commit this checkout is on against one opponent, under the
# conditions in strength/README.md, summarise the games, and print the line
# that records the match in strength/records.tsv.
#
#   strength/measure stockfish <new directory>
#   strength/measure <revision of fisher> <new directory>
set -eu
unset CDPATH

if [ $# -ne 2 ]; then
    echo "usage: strength/measure (stockfish | <revision of fisher>) <new directory>" >&2
    exit 2
fi
opponent=$1
root=$(cd "$(dirname "$0")/.." && pwd)
python=${PYTHON:-python3}

# The conditions these settings make up, as numbered in strength/README.md.
conditions=1
games=400
concurrency=8
# A fisher that ignores the clocks gets one it will not run out of.
fisher_clock=600+10

if ! command -v cargo >/dev/null 2>&1; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

stop() {
    echo "$1" >&2
    exit 1
}

command -v fastchess >/dev/null 2>&1 || stop "fastchess is not installed."
"$python" -c 'import chess' 2>/dev/null ||
    stop "$python cannot import python-chess. Install it with: pip install chess==1.11.2, or set PYTHON."
if [ "$opponent" = stockfish ]; then
    stockfish=$(command -v stockfish) || stop "stockfish is not installed."
    stockfish_name=$(printf 'uci\nquit\n' | "$stockfish" | sed -n 's/^id name //p')
    [ -n "$stockfish_name" ] || stop "$stockfish did not give its name over UCI."
else
    opponent_revision=$(git -C "$root" rev-parse --verify --quiet "$opponent^{commit}") ||
        stop "$opponent is neither stockfish nor a commit of fisher."
fi

# A directory of its own, so that nothing left by another match can be
# mistaken for this one's games or record.
if [ -e "$2" ] && [ -n "$(ls -A "$2")" ]; then
    stop "$2 is not empty. Give a new directory."
fi
mkdir -p "$2"
out=$(cd "$2" && pwd)

# Build fisher from a commit, never from the working files, so that the hash
# in the record names exactly the engine that played.
build() {
    commit=$1
    engine=$2
    mkdir "$out/source"
    git -C "$root" archive -o "$out/source.tar" "$commit"
    tar -x -f "$out/source.tar" -C "$out/source"
    (cd "$out/source" && cargo build --locked --release -p fisher --target-dir "$out/source/target")
    cp "$out/source/target/release/fisher" "$out/$engine"
    rm -rf "$out/source" "$out/source.tar"
}

revision=$(git -C "$root" rev-parse HEAD)
name=fisher-$(git -C "$root" rev-parse --short "$revision")
if [ -n "$(git -C "$root" status --porcelain -- crates Cargo.toml Cargo.lock)" ]; then
    echo "Uncommitted changes are not measured. This plays commit $revision." >&2
fi
build "$revision" "$name"

if [ "$opponent" = stockfish ]; then
    opponent_name=stockfish-1320
    opponent_record="$stockfish_name, UCI_Elo 1320"
    set -- "cmd=$stockfish" "name=$opponent_name" tc=10+0.1 \
        option.UCI_LimitStrength=true option.UCI_Elo=1320 option.Threads=1 option.Hash=16
else
    opponent_name=opponent-$(git -C "$root" rev-parse --short "$opponent_revision")
    opponent_record=$opponent_revision
    build "$opponent_revision" "$opponent_name"
    set -- "cmd=$out/$opponent_name" "name=$opponent_name" "tc=$fisher_clock"
fi

cd "$out"
runner=$(fastchess --version | sed 's/ *$//')
echo "$name against $opponent_name: $games games, $concurrency at a time"

if ! fastchess \
    -engine "cmd=$out/$name" "name=$name" "tc=$fisher_clock" \
    -engine "$@" \
    -each proto=uci \
    -openings "file=$root/strength/openings.epd" format=epd order=sequential \
    -rounds "$((games / 2))" -games 2 -concurrency "$concurrency" \
    -pgnout file=games.pgn append=false \
    -autosaveinterval 0 -ratinginterval 0 >fastchess.log 2>&1; then
    tail -n 20 fastchess.log >&2
    stop "fastchess failed. Its output is in $out/fastchess.log"
fi

# fastchess colours its output even when it is not written to a terminal.
sed "s/$(printf '\033')\[[0-9;]*m//g" fastchess.log | sed -n '/^Results of /,$p' >results.txt
cat results.txt
"$python" "$root/strength/summarise.py" games.pgn "$name"

summary=$("$python" "$root/strength/summarise.py" --record games.pgn "$name")
played=$(printf '%s\n' "$summary" | cut -f 1)
[ "$played" = "$games" ] || stop "The PGN holds $played games, not $games. This match is not a record."
# fastchess gives the Elo difference from the first engine's point of view: fisher's.
elo=$(sed -n 's|^Elo: \([^ ]*\) +/- \([^,]*\),.*|\1 \2|p' results.txt)
case $elo in
*" "*) ;;
*) stop "fastchess printed no Elo line. Its output is in $out/fastchess.log" ;;
esac

printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date +%Y-%m-%d)" "$revision" "$opponent_record" "$conditions" \
    "$summary" "${elo% *}" "${elo#* }" "$runner" >record.tsv
echo
echo "The games are in $out/games.pgn. To record the match, add this line to strength/records.tsv:"
cat record.tsv
