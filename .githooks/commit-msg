#!/usr/bin/env bash
# A commit that changes what does the checking has to say so, so the human can
# find it and read it: git log --grep '^Guard-Change:'
set -euo pipefail

message_file=$1
root=$(git rev-parse --show-toplevel)

# A merge brings in commits that were each checked when they were made.
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
  exit 0
fi

touched=$(
  git diff --cached --name-only --no-renames -z |
    { LC_ALL=C grep -azE -f "$root/.githooks/protected-paths" || [ "$?" -eq 1 ]; } |
    while IFS= read -r -d '' path; do
      printf '  %q\n' "$path"
    done
)
if [ -z "$touched" ]; then
  exit 0
fi

# Match Git's comment prefix, including the newer core.commentString alias.
comment_config=$(git config --get-regexp '^core\.comment(char|string)$' || [ "$?" -eq 1 ])
comment_config=${comment_config##*$'\n'}
comment_prefix=${comment_config#* }
comment_prefix=${comment_prefix:-#}

# The cleanup mode is unavailable here. Require a subject, a blank line and
# a reason that survive comment stripping and truncation at the scissors line.
if body=$(LC_ALL=C COMMENT_PREFIX="$comment_prefix" awk '
    BEGIN {
        prefix = ENVIRON["COMMENT_PREFIX"]
        auto_comment = tolower(prefix) == "auto"
        width = auto_comment ? 1 : length(prefix)
        scissors = " ------------------------ >8 ------------------------"
    }
    {
        start = substr($0, 1, width)
        comment = auto_comment ? index("#;@!$%^&|:", start) && start != "" : start == prefix
        if (comment && index(substr($0, width + 1), scissors) == 1) exit (subject ? 0 : 2)
        if ($0 ~ /^[ \t\r]*$/) {
            if (subject && !comment) body = 1
            next
        }
        if (!subject && comment) exit 2
        subject = 1
        if (body && !comment) print
    }
  ' "$message_file"); then
  if printf '%s\n' "$body" | LC_ALL=C grep -aE $'^Guard-Change: .*[^ \t\r]' >/dev/null; then
    exit 0
  fi
elif [ "$?" -eq 2 ]; then
  echo "A subject starting with the Git comment character can be removed by Git's default editor cleanup. Start the subject with another character." >&2
fi

{
  echo "This commit changes protected paths:"
  printf '%s\n' "$touched"
  echo
  echo "These files decide what counts as green, so the human reads every change to them."
  echo "If the change is intended, add a line to the commit body above the scissors line saying why:"
  echo
  echo "  Guard-Change: <what this does to the checks, and why>"
  echo
  echo "If you changed one of them only to get a check to pass, undo that change instead."
} >&2
exit 1
