#!/usr/bin/env python3
"""Exercise await-merge with a stand-in gh and no network."""

import json
from pathlib import Path
import runpy
import subprocess
import sys
import tempfile
from types import SimpleNamespace
import unittest
from unittest.mock import patch


SCRIPT = Path(__file__).resolve().with_name("await-merge")
HANG_TIMEOUT = 120
VIEW = ["pr", "view", "42", "--json",
        "state,mergeStateStatus,mergeable,baseRefName,headRefOid,statusCheckRollup,isDraft"]
BASE = ["api", "repos/{owner}/{repo}/git/ref/heads/main", "--jq", ".object.sha"]
UPDATE = ["pr", "update-branch", "42"]
UPDATE_ERROR = {"error": "X Cannot update PR branch due to conflicts"}
FIRST_BASE = "a" * 40
SECOND_BASE = "b" * 40


def run_fixture():
    steps = json.load(sys.stdin)
    calls = []
    sleeps = []

    def run_gh(command, *, timeout, text, capture_output, check):
        executable, *args = command
        expected, output = steps[min(len(calls), len(steps) - 1)]
        calls.append(args)
        if executable != "gh" or args != expected:
            raise AssertionError(f"Unexpected command: {command!r}, expected gh {expected!r}")
        if not text or not capture_output:
            raise AssertionError("Expected gh output to be captured as text")
        # Scripted replies are instantaneous on the controlled clock.
        if timeout <= 0:
            raise AssertionError(f"gh called with no time remaining: {command!r}")
        if isinstance(output, dict) and "error" in output:
            result = subprocess.CompletedProcess(command, 1, "", output["error"] + "\n")
        else:
            stdout = output if isinstance(output, str) else json.dumps(output)
            result = subprocess.CompletedProcess(command, 0, stdout + "\n", "")
        if check:
            result.check_returncode()
        return result

    sys.argv[:2] = [str(SCRIPT)]
    main = runpy.run_path(str(SCRIPT))["main"]
    main.__globals__["time"] = SimpleNamespace(monotonic=lambda: sum(sleeps), sleep=sleeps.append)
    try:
        with patch.object(subprocess, "run", run_gh):
            main()
    finally:
        Path("trace").write_text(json.dumps((calls, sleeps)))


def pull(state="OPEN", merge_state="BLOCKED", mergeable="MERGEABLE",
         head="first-head", checks=(), base="main", draft=False):
    return VIEW, {
        "state": state, "mergeStateStatus": merge_state, "mergeable": mergeable,
        "baseRefName": base, "headRefOid": head, "statusCheckRollup": checks, "isDraft": draft,
    }


def check(name, status, conclusion="", started="2026-11-26T01:00:00Z", job=100):
    return {
        "__typename": "CheckRun", "name": name, "status": status,
        "conclusion": conclusion, "startedAt": started,
        "detailsUrl": f"https://github.com/fernandobandeira/fisher/actions/runs/42/job/{job}",
    }


class AwaitMergeTest(unittest.TestCase):
    def run_script(self, steps, timeout="4", interval="0.25", expected_sleeps=None):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            result = subprocess.run(
                [sys.executable, str(Path(__file__).resolve()), "--run-fixture",
                 "42", "--timeout", timeout, "--interval", interval],
                cwd=root, input=json.dumps(steps), capture_output=True, text=True,
                timeout=HANG_TIMEOUT,
            )
            trace = root / "trace"
            self.assertTrue(trace.exists(), result)
            calls, sleeps = json.loads(trace.read_text())
            if expected_sleeps is not None:
                self.assertEqual(sleeps, expected_sleeps)
            return result, calls

    def assert_steps(self, steps, status, message, **options):
        result, calls = self.run_script(steps, **options)
        self.assertEqual(result.returncode, status, result)
        self.assertIn(message, result.stdout + result.stderr)
        self.assertEqual(calls, [args for args, _ in steps])

    def test_updates_once_for_each_main_commit_and_ignores_old_head_failure(self):
        behind = pull(merge_state="BEHIND")
        stale = pull(merge_state="BEHIND", checks=[check("mutation", "COMPLETED", "CANCELLED")])
        next_head = pull(merge_state="BEHIND", head="second-head")
        self.assert_steps([
            behind, (BASE, FIRST_BASE), (UPDATE, ""),
            stale, (BASE, FIRST_BASE),
            next_head, (BASE, SECOND_BASE), (UPDATE, ""),
            pull(state="MERGED", merge_state="UNKNOWN", head="third-head"),
        ], 0, "merged")

    def test_already_merged(self):
        self.assert_steps([pull(state="MERGED", merge_state="UNKNOWN")], 0, "merged")

    def test_closed(self):
        self.assert_steps([pull(state="CLOSED")], 1, "closed without merging")

    def test_required_check_failure_after_head_changes(self):
        for conclusion in ("FAILURE", "CANCELLED", "TIMED_OUT"):
            with self.subTest(conclusion=conclusion):
                self.assert_steps([
                    pull(merge_state="BEHIND"), (BASE, FIRST_BASE), (UPDATE, ""),
                    pull(head="second-head", checks=[check("coverage", "COMPLETED", conclusion)]),
                ], 1, f"required check coverage finished with {conclusion} at second-head")

    def test_waits_for_pending_checks_and_ignores_other_results(self):
        checks = [
            check("mutation", "QUEUED"), check("coverage", "IN_PROGRESS"),
            check("mutation-part (0)", "COMPLETED", "FAILURE"),
            {"__typename": "StatusContext", "context": "check", "state": "FAILURE"},
        ]
        self.assert_steps([
            pull(checks=checks), pull(state="MERGED", merge_state="UNKNOWN"),
        ], 0, "merged")

    def test_newest_required_check_supersedes_older_failure(self):
        older = check("guard-change", "COMPLETED", "FAILURE")
        for status, conclusion in (("COMPLETED", "SUCCESS"), ("IN_PROGRESS", "")):
            newer = check("guard-change", status, conclusion, "2026-11-26T01:01:00Z")
            for checks in ([older, newer], [newer, older]):
                with self.subTest(status=status, checks=checks):
                    self.assert_steps([
                        pull(checks=checks), pull(state="MERGED", merge_state="UNKNOWN"),
                    ], 0, "merged")

    def test_unstarted_queued_run_supersedes_failure(self):
        older = check("guard-change", "COMPLETED", "FAILURE", job=99)
        queued = check("guard-change", "QUEUED", started="0001-01-01T00:00:00Z", job=100)
        self.assert_steps([
            pull(checks=[older, queued]), pull(state="MERGED", merge_state="UNKNOWN"),
        ], 0, "merged")

    def test_required_runs_started_at_same_time_use_numeric_job_id(self):
        for newer_conclusion in ("SUCCESS", "FAILURE"):
            older_conclusion = "FAILURE" if newer_conclusion == "SUCCESS" else "SUCCESS"
            older = check("guard-change", "COMPLETED", older_conclusion, job=99)
            newer = check("guard-change", "COMPLETED", newer_conclusion, job=100)
            for checks in ([older, newer], [newer, older]):
                with self.subTest(newer_conclusion=newer_conclusion, checks=checks):
                    if newer_conclusion == "SUCCESS":
                        self.assert_steps([
                            pull(checks=checks), pull(state="MERGED", merge_state="UNKNOWN"),
                        ], 0, "merged")
                    else:
                        self.assert_steps([
                            pull(checks=checks),
                        ], 1, "required check guard-change finished with FAILURE")

    def test_newer_required_failure_ends_wait(self):
        older = check("guard-change", "COMPLETED", "SUCCESS")
        newer = check("guard-change", "COMPLETED", "FAILURE", "2026-11-26T01:01:00Z")
        self.assert_steps([
            pull(checks=[older, newer]),
        ], 1, "required check guard-change finished with FAILURE")

    def test_first_failed_read_reports_github_error_and_stops(self):
        result, calls = self.run_script([
            (VIEW, {"error": "Could not resolve pull request #42"}),
            pull(state="MERGED", merge_state="UNKNOWN"),
        ])
        self.assertEqual(result.returncode, 1, result)
        self.assertIn("Could not resolve pull request #42", result.stderr)
        self.assertEqual(calls, [VIEW])

    def test_later_failed_read_warns_with_github_error_and_keeps_waiting(self):
        result, calls = self.run_script([
            pull(), (VIEW, {"error": "temporary GitHub error\ntry again"}),
            pull(state="MERGED", merge_state="UNKNOWN"),
        ])
        self.assertEqual(result.returncode, 0, result)
        self.assertIn("merged", result.stdout)
        self.assertEqual(len(result.stderr.splitlines()), 1, result)
        self.assertIn("Warning:", result.stderr)
        self.assertIn("temporary GitHub error try again", result.stderr)
        self.assertEqual(calls, [VIEW, VIEW, VIEW])

    def test_retries_failed_or_unreadable_pull_request_reads(self):
        for output in ({"error": "temporary GitHub error"}, "{", "{}"):
            with self.subTest(output=output):
                result, calls = self.run_script([
                    pull(), (VIEW, output), pull(state="MERGED", merge_state="UNKNOWN"),
                ])
                self.assertEqual(result.returncode, 0, result)
                self.assertEqual(len(result.stderr.splitlines()), 1, result)
                self.assertIn("Warning:", result.stderr)
                self.assertEqual(len(calls), 3)

    def test_retries_failed_or_unreadable_main_reads(self):
        behind = pull(merge_state="BEHIND")
        for output in ({"error": "temporary GitHub error"}, "not a commit"):
            with self.subTest(output=output):
                result, calls = self.run_script([
                    behind, (BASE, output), behind, (BASE, FIRST_BASE), (UPDATE, ""),
                    pull(state="MERGED", merge_state="UNKNOWN"),
                ])
                self.assertEqual(result.returncode, 0, result)
                self.assertEqual(len(result.stderr.splitlines()), 1, result)
                self.assertIn("Warning:", result.stderr)
                self.assertEqual(calls, [VIEW, BASE, VIEW, BASE, UPDATE, VIEW])

    def test_persistent_read_error_reaches_time_limit(self):
        result, calls = self.run_script([pull(), (VIEW, {"error": "temporary GitHub error"})], timeout="0.75")
        self.assertEqual(result.returncode, 1, result)
        self.assertIn("Warning:", result.stderr)
        self.assertIn("Timed out waiting for pull request #42", result.stderr)
        self.assertIn("OPEN/BLOCKED at first-head", result.stderr)
        self.assertGreater(len(calls), 2)

    def test_failed_update_followed_by_merge(self):
        behind = pull(merge_state="BEHIND")
        for reads in ([pull(state="MERGED")], [behind, pull(state="MERGED")]):
            with self.subTest(reads=reads):
                self.assert_steps([
                    behind, (BASE, FIRST_BASE), (UPDATE, UPDATE_ERROR), *reads,
                ], 0, "Pull request #42 merged.")

    def test_failed_update_followed_by_late_merge(self):
        behind = pull(merge_state="BEHIND")
        self.assert_steps([
            behind, (BASE, FIRST_BASE), (UPDATE, UPDATE_ERROR),
            *([behind] * 5), pull(state="MERGED"),
        ], 0, "Pull request #42 merged.", timeout="60", interval="15", expected_sleeps=[5] * 5)

    def test_failed_update_ends_wait(self):
        behind = pull(merge_state="BEHIND")
        steps = [behind, (BASE, FIRST_BASE), (UPDATE, UPDATE_ERROR), *([behind] * 6)]
        result, calls = self.run_script(steps + [pull(state="MERGED")],
                                        timeout="60", interval="15", expected_sleeps=[5] * 6)
        self.assertEqual(result.returncode, 1, result)
        self.assertIn("Could not wait for pull request #42", result.stderr)
        self.assertIn(UPDATE_ERROR["error"], result.stderr)
        self.assertEqual(calls, [args for args, _ in steps])

    def test_failed_update_followed_by_closed_draft_or_conflicting(self):
        for fresh, message in (
            (pull(state="CLOSED"), "closed without merging"),
            (pull(draft=True), "is a draft"),
            (pull(merge_state="DIRTY", mergeable="CONFLICTING"), "conflicts with main. Rebase is needed"),
        ):
            with self.subTest(message=message):
                self.assert_steps([
                    pull(merge_state="BEHIND"), (BASE, FIRST_BASE), (UPDATE, UPDATE_ERROR), fresh,
                ], 1, message)

    def test_failed_update_reads_within_time_limit(self):
        behind = pull(merge_state="BEHIND")
        result, calls = self.run_script([
            behind, (BASE, FIRST_BASE), (UPDATE, UPDATE_ERROR), behind,
            pull(state="MERGED"),
        ], timeout="1", interval="15", expected_sleeps=[1])
        self.assertEqual(result.returncode, 1, result)
        self.assertIn(UPDATE_ERROR["error"], result.stderr)
        self.assertEqual(calls, [VIEW, BASE, UPDATE, VIEW])

    def test_draft_ends_wait(self):
        self.assert_steps([pull(draft=True)], 1, "Pull request #42 is a draft")

    def test_conflict(self):
        self.assert_steps([
            pull(merge_state="BEHIND"), (BASE, FIRST_BASE), (UPDATE, ""),
            pull(merge_state="DIRTY", mergeable="CONFLICTING"),
        ], 1, "conflicts with main. Rebase is needed")

    def test_other_base(self):
        self.assert_steps([pull(base="another-branch")], 1, "must target main")

    def test_timeout(self):
        result, calls = self.run_script([pull()], timeout="0.5")
        self.assertEqual(result.returncode, 1, result)
        self.assertIn("Timed out waiting for pull request #42", result.stderr)
        self.assertIn("OPEN/BLOCKED at first-head", result.stderr)
        self.assertTrue(calls)
        self.assertTrue(all(args == VIEW for args in calls))


if __name__ == "__main__":
    if sys.argv[1:2] == ["--run-fixture"]:
        run_fixture()
    else:
        unittest.main()
