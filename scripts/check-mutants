#!/usr/bin/env python3
"""Run cargo-mutants and check survivors against reviewed equivalents."""

import argparse
from collections import Counter, defaultdict
from hashlib import sha256
import json
import re
from pathlib import Path
import subprocess
import sys
from tempfile import TemporaryDirectory, mkdtemp

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ".cargo/mutation-gate.json"
VERSION = "27.1.0"
TEST_ATTRIBUTE = re.compile(rb"#\s*!?\s*\[\s*(?:test\s*\]|cfg(?:_attr)?\s*\([^]]*\btest\b)")
OUTCOMES = {
    "CaughtMutant": "caught",
    "Unviable": "unviable",
    "MissedMutant": "surviving",
    "Timeout": "timeout",
}


def key(mutant, site):
    return mutant["file"], mutant["function"], mutant["replacement"], tuple(site)


def reviewed_entries(entries):
    reviewed = {}
    for entry in entries:
        identity = key(entry, entry["site"])
        if identity in reviewed or not entry["proof"].strip() or not identity[-1]:
            raise ValueError(f"Give each equivalent mutant one distinct site and a proof: {identity}")
        digest = entry["function_sha256"]
        if not re.fullmatch(r"[0-9a-f]{64}", digest):
            raise ValueError(f"Record the SHA-256 of the reviewed function: {identity}")
        reviewed[identity] = digest
    return reviewed


def mutation_site(diff):
    # Ignore hunk coordinates and unchanged context. Keep the mutation marker so
    # two replacements on the same source line can still be distinguished.
    return tuple(
        line[0] + line[1:].strip()
        for line in diff.splitlines()[2:]
        if line.startswith(("-", "+"))
    )


def function_digest(source, span):
    # Cargo-mutants reports one-based character positions and an exclusive end.
    lines = source.split("\n")
    start, end = span["start"], span["end"]
    first, last = start["line"] - 1, end["line"] - 1
    begin, limit = start["column"] - 1, end["column"] - 1
    if first == last:
        function = lines[first][begin:limit]
    else:
        function = "\n".join([lines[first][begin:], *lines[first + 1:last], lines[last][:limit]])
    return sha256(function.encode("utf-8")).hexdigest()


def reconcile(results, reviewed, full, log_directory="mutants.out/log"):
    counts = defaultdict(Counter)
    seen = Counter()
    listed_survivors = set()
    changed_functions = set()
    problems = []
    for mutant, outcome, site in results:
        identity = key(mutant, site)
        seen[identity] += 1
        crate = mutant["package"]
        counts[crate][outcome] += 1
        if outcome == "timeout":
            problems.append(
                f"{mutant['name']} timed out. Inspect its log in {log_directory} "
                "and add a test that rejects the mutation without hanging."
            )
        if outcome != "surviving":
            continue
        if identity in reviewed and mutant["function_sha256"] == reviewed[identity]:
            counts[crate]["equivalent"] += 1
            listed_survivors.add(identity)
        elif identity in reviewed:
            changed_functions.add(identity)
            problems.append(
                f"{mutant['name']} survived after its enclosing function changed. "
                f"Review its proof in {CONFIG} before updating the digest "
                f"({mutant['function_sha256']}), or add a test that catches it."
            )
        else:
            problems.append(
                f"{mutant['name']} survived. Add a test that catches it, or propose a proof "
                f"of equivalence in {CONFIG}.\n  Site: {json.dumps(site)}"
            )
    for identity in listed_survivors:
        if seen[identity] != 1:
            problems.append(f"Ambiguous equivalent mutant {identity}. Give it a distinct site.")
    if full:
        for identity in reviewed.keys() - listed_survivors:
            if identity not in seen:
                problems.append(f"Reviewed mutant {identity} no longer exists. Update {CONFIG}.")
            elif identity not in changed_functions:
                problems.append(f"Reviewed mutant {identity} no longer survives. Update {CONFIG}.")
    return counts, sorted(problems)


def read_results(output, status):
    plan = output / "mutants.json"
    outcomes = output / "outcomes.json"
    if status == 0 and not plan.exists() and not outcomes.exists():
        return
    planned = json.loads(plan.read_text())
    if not planned and status == 0:
        return
    report = json.loads(outcomes.read_text())
    results = [item for item in report["outcomes"] if item["scenario"] != "Baseline"]
    if not report["end_time"] or len(results) != len(planned):
        raise ValueError("Mutation results are incomplete. Rerun scripts/check-mutants.")
    for item in results:
        mutant = item["scenario"]["Mutant"]
        function = mutant["function"]
        mutant["function"] = function["function_name"] if function else None
        mutant["function_sha256"] = (
            function_digest((ROOT / mutant["file"]).read_bytes().decode("utf-8"), function["span"])
            if function else None
        )
        site = mutation_site((output / item["diff_path"]).read_text())
        yield mutant, OUTCOMES[item["summary"]], site


def test_sources(path, *sources):
    location = path.parts[2:]
    if not location:
        return False
    if location[0] == "tests":
        return True
    return location[0] == "src" and path.suffix == ".rs" and (
        "tests" in location[1:-1] or path.name == "tests.rs"
        or any(TEST_ATTRIBUTE.search(source) for source in sources)
    )


def test_changes(base):
    changes = iter(subprocess.check_output(
        ["git", "diff", "--name-status", "--no-renames", "-z", base, "HEAD", "--", "crates/"],
        cwd=ROOT,
    ).decode().split("\0"))
    directories = set()
    for status in changes:
        if not status:
            break
        path = Path(next(changes))
        if test_sources(path):
            directories.add(path.parts[1])
            continue
        if path.suffix != ".rs" or path.parts[2:3] != ("src",):
            continue
        # Look at both revisions so removing the last test still triggers the crate.
        sources = [
            subprocess.check_output(["git", "show", f"{revision}:{path.as_posix()}"], cwd=ROOT)
            for revision, missing in ((base, "A"), ("HEAD", "D"))
            if status != missing
        ]
        if test_sources(path, *sources):
            directories.add(path.parts[1])
    return directories


def workspace_packages(directories):
    if not directories:
        return []
    metadata = json.loads(subprocess.check_output(
        ["cargo", "metadata", "--locked", "--no-deps", "--format-version", "1"], cwd=ROOT
    ))
    members = set(metadata["workspace_members"])
    return sorted(
        (package["name"], directory)
        for package in metadata["packages"]
        if package["id"] in members
        for directory in [Path(package["manifest_path"]).parent.name]
        if directory in directories
    )


def mutation_batches(args, output):
    if args.in_diff is None:
        yield "workspace", ["--workspace"]
        return

    base = subprocess.check_output(
        ["git", "merge-base", "--", args.in_diff, "HEAD"], cwd=ROOT, text=True,
    ).strip()
    packages = workspace_packages(test_changes(base))
    excluded = [f":(exclude,literal)crates/{directory}" for _, directory in packages]
    patch = output / "base.diff"
    with patch.open("wb") as destination:
        subprocess.run(
            ["git", "diff", "--no-ext-diff", "--no-textconv", "--no-color",
             "--no-renames", base, "HEAD", "--", "crates/", *excluded],
            cwd=ROOT, stdout=destination, check=True,
        )
    if patch.stat().st_size:
        yield "changed-source", ["--workspace", "--in-diff", str(patch)]
    if packages:
        print("Tests changed in: " + ", ".join(package for package, _ in packages), flush=True)
        yield "changed-tests", [arg for package, _ in packages for arg in ("--package", package)]


def mutation_command(jobs):
    return [
        "cargo", "mutants", "--no-config", "--test-workspace=false", "--cap-lints=true",
        "--minimum-test-timeout", "120", "--annotations=none", "--copy-target=false", "--cargo-arg=--locked",
        "--cargo-test-arg=--tests", "--jobs", str(jobs),
    ]


def self_test():
    # Both diff batches and the full run use the same package-only policy.
    options = mutation_command(4)
    assert "--test-workspace=false" in options and "--test-workspace=true" not in options
    assert "--no-config" in options
    assert "--cargo-test-arg=--tests" in options
    assert test_sources(Path("crates/search/tests/search.rs"), b"")
    assert test_sources(Path("crates/search/tests/fixture.json"))
    assert test_sources(Path("crates/uci/src/command/tests/helpers.rs"), b"")
    assert test_sources(Path("crates/uci/src/lib.rs"), b"#[cfg( any(test, doctest) )]", b"")
    assert not test_sources(Path("crates/rules/src/lib.rs"), b"#[cfg(feature = \"contest\")]")
    assert not test_sources(Path("crates/rules/Cargo.toml"), b"")
    with TemporaryDirectory() as directory:
        fresh = Path(directory) / "fresh" / "mutants.out"
        stale = Path(directory) / "mutants.out"
        stale.mkdir()
        (stale / "mutants.json").write_text("invalid stale report")
        assert list(read_results(fresh, 0)) == []

    source = "fn score(score: i32) -> bool {\n    score != 0 && score > 0\n}"
    span = {"start": {"line": 1, "column": 1}, "end": {"line": 3, "column": 2}}
    digest = function_digest(source, span)
    assert digest == sha256(source.encode()).hexdigest()
    shifted_span = {"start": {"line": 2, "column": 1}, "end": {"line": 4, "column": 2}}
    assert function_digest("// a new comment\n" + source, shifted_span) == digest
    assert function_digest("é fn f() {}", {
        "start": {"line": 1, "column": 3}, "end": {"line": 1, "column": 12},
    }) == sha256(b"fn f() {}").hexdigest()
    changed_digest = function_digest(source.replace("score != 0", "score == 0"), span)

    mutant = {
        "file": "crates/search/src/lib.rs",
        "function": "score",
        "replacement": ">=",
        "package": "search",
        "name": "replace > with >=",
        "function_sha256": digest,
    }
    diff = "--- before\n+++ after\n@@ -10,2 +10,2 @@\n-    score > 0\n+    score >= 0\n"
    site = mutation_site(diff)
    shifted = mutation_site(diff.replace("-10,2 +10,2", "-90,2 +90,2"))
    assert site == shifted == ("-score > 0", "+score >= 0")
    reviewed = reviewed_entries([{**mutant, "site": site, "proof": "Score cannot be zero here."}])

    counts, problems = reconcile([(mutant, "surviving", shifted)], reviewed, full=True)
    assert not problems and counts["search"]["equivalent"] == 1
    stale = {**mutant, "function_sha256": changed_digest}
    for full in (False, True):
        assert "function changed" in reconcile([(stale, "surviving", site)], reviewed, full)[1][0]
    assert "survived" in reconcile([(mutant, "surviving", site)], {}, full=False)[1][0]
    other = ("-nodes > 0", "+nodes >= 0")
    assert "survived" in reconcile([(mutant, "surviving", other)], reviewed, full=False)[1][0]
    assert "Ambiguous" in reconcile([(mutant, "surviving", site)] * 2, reviewed, full=True)[1][0]
    assert "no longer survives" in reconcile([(mutant, "caught", site)], reviewed, full=True)[1][0]
    assert "no longer exists" in reconcile([], reviewed, full=True)[1][0]
    assert not reconcile([], reviewed, full=False)[1]
    assert any("timed out" in problem for problem in
               reconcile([(mutant, "timeout", site)], reviewed, full=True)[1])


def run(args):
    install = f"Install cargo-mutants with `cargo install cargo-mutants --version {VERSION} --locked`."
    version = subprocess.run(["cargo", "mutants", "--version"], cwd=ROOT, capture_output=True, text=True)
    if version.returncode or version.stdout.strip() != f"cargo-mutants {VERSION}":
        raise ValueError(install)

    config = json.loads((ROOT / CONFIG).read_text())
    reviewed = reviewed_entries(config["equivalent"])
    args.output.mkdir(parents=True, exist_ok=True)
    output = Path(mkdtemp(prefix="run-", dir=args.output.resolve()))
    print(f"Mutation reports: {output}", flush=True)
    command = mutation_command(args.jobs)
    counts = defaultdict(Counter)
    problems = []
    for name, options in mutation_batches(args, output):
        destination = output / name
        destination.mkdir()
        status = subprocess.run(command + options + ["--output", str(destination)], cwd=ROOT).returncode
        if status not in {0, 2, 3}:
            raise ValueError(
                f"cargo-mutants exited {status}. Fix the error above and rerun scripts/check-mutants."
            )

        report = destination / "mutants.out"
        batch_counts, batch_problems = reconcile(
            read_results(report, status), reviewed, full=args.in_diff is None,
            log_directory=report / "log",
        )
        for crate, outcomes in batch_counts.items():
            counts[crate].update(outcomes)
        problems.extend(batch_problems)
        if status == 3 and not batch_problems:
            problems.append(f"{name}: cargo-mutants reported a timeout. Inspect {report / 'log'}.")
    if not counts:
        print("No mutants to reconcile.")
    for crate in sorted(counts):
        summary = ", ".join(f"{counts[crate][name]} {name}" for name in
                            ("caught", "unviable", "surviving", "equivalent", "timeout"))
        print(f"{crate}: {summary}")
    for problem in problems:
        print(problem, file=sys.stderr)
    return int(bool(problems))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--in-diff", metavar="BASE", help="test mutations in changes from BASE to HEAD")
    parser.add_argument("--jobs", type=int, default=4)
    parser.add_argument("--output", type=Path, default=ROOT / "target/mutation")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    if args.self_test:
        self_test()
        return 0
    try:
        return run(args)
    except (OSError, subprocess.CalledProcessError, ValueError, KeyError) as error:
        print(f"Could not check mutants: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
