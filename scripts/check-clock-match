#!/usr/bin/env python3
"""Build, play and verify the weekly real-clock match.

Usage: scripts/check-clock-match FASTCHESS NEW_EVIDENCE_DIRECTORY
Install the pinned PGN replay library and its build tool as in .github/workflows/clock-match.yml.
"""
import collections
import contextlib
import io
import json
import os
from pathlib import Path
import platform
import re
import shlex
import signal
import subprocess
import sys
import time

import chess.pgn


GAME_COUNT = 1000
MATCH_SECONDS = 3600
STOP_SECONDS = 10
RESULT = r"(?:1-0|0-1|1/2-1/2)"
MOVE = r"[a-h][1-8][a-h][1-8][qrbn]?"
ENGINE = r"fisher-[ab]"
PAIR = rf"\({ENGINE} vs {ENGINE}\)"
NUMBER = r"-?(?:\d+(?:\.\d+)?|inf|nan)"
IDS = set(range(1, GAME_COUNT + 1))
PV_WARNING = re.compile(
    rf"Warning; PV continues after (threefold repetition|fifty-move rule) - move {MOVE} from {ENGINE}"
)
WARNING_COUNTS = {"threefold repetition": "repetition_warnings", "fifty-move rule": "fifty_move_warnings"}
DIAGNOSTICS = tuple(map(re.compile, (
    r"Info; info depth \d+ multipv \d+ score (?:cp|mate) -?\d+ "
    rf"nodes \d+ nps \d+ time \d+ pv {MOVE}(?: {MOVE})*",
    r"Position; fen ([prnbqkPRNBQK1-8/]+ [wb] (?:[KQkq]+|-) (?:[a-h][36]|-) \d+ \d+)",
    rf"Moves; (?:{MOVE}(?: {MOVE})*)?",
)))
LOSS_ON_TIME = re.compile(r"(?:White|Black) loses on time \(\d+ms overrun\)")
NORMAL_FINISH = re.compile(
    r"(?:White|Black) mates|Draw by (?:3-fold repetition|insufficient mating material|fifty moves rule|stalemate)"
)
CONSOLE_FINISH = re.compile(rf"Finished game (\d+) {PAIR}: ({RESULT}) \{{([^{{}}]+)\}}")
PASSIVE_EVENTS = {"tournament_started", "game_started", "move"}
GAME_ABORTED = "game_aborted"
GAME_FINISHED = "game_finished"
TOURNAMENT_FINISHED = "tournament_finished"
EVENT_KINDS = PASSIVE_EVENTS | {GAME_ABORTED, GAME_FINISHED, TOURNAMENT_FINISHED}
RESULT_MARKER = re.compile(rf"(?:^|\s)({RESULT})$")
PGN_HEADERS = re.compile(r"(?:\[[^\n]*\]\n|[ \t]*\n|[%;][^\n]*\n)*")
RESULT_HEADER = re.compile(r'(?m)^\[Result[ \t]+"([^"\n]*)"\][ \t]*$')
PGN_TOKENS = re.compile(
    r"(?m)\{[^}]*\}|^%[^\n]*|;[^\n]*|[{}()]|"
    r"(?P<annotation>\d+\.(?:\.\.)?|\$\d+|[!?]{1,2})|[^\s{}();!?$]+|\S"
)
# These are the console shapes reviewed for the pinned fastchess release.
# Review the list when deliberately changing the pin. Everything else fails.
CONSOLE = tuple(map(re.compile, (
    r"",
    r"-{50}",
    rf"Started game \d+ of {GAME_COUNT} {PAIR}",
    r"Results of fisher-a vs fisher-b \(10/1, NULL, NULL, openings\.epd\):",
    rf"Elo: {NUMBER} \+/- {NUMBER}, nElo: {NUMBER} \+/- {NUMBER}",
    rf"LOS: {NUMBER} %, DrawRatio: {NUMBER} %, PairsRatio: {NUMBER}",
    rf"Games: \d+, Wins: \d+, Losses: \d+, Draws: \d+, Points: {NUMBER} \({NUMBER} %\)",
    rf"Ptnml\(0-2\): \[\d+(?:, \d+){{4}}\], WL/DD Ratio: {NUMBER}",
    rf"Player: {ENGINE}",
    r"  (?:Timeouts|Crashed): \d+",
    r"Tournament was interrupted\. To resume the tournament, run: [^\r\n]+ -config file=config\.json",
    r"Finished match",
    r"Total Time: \d+:\d{2}:\d{2} \(hours:minutes:seconds\)",
)))


def runner_cores():
    if sys.platform == "linux":
        return int(subprocess.check_output(["nproc"]))
    return os.cpu_count() or 1


def kill_match_group(process):
    with contextlib.suppress(ProcessLookupError):
        os.killpg(process.pid, signal.SIGKILL)


def run_match(command, evidence):
    started = time.monotonic()
    deadline_reached = False
    with (evidence / "fastchess.log").open("w") as stream:
        with subprocess.Popen(
            command, cwd=evidence, stdout=stream, stderr=subprocess.STDOUT, start_new_session=True,
        ) as process:
            try:
                try:
                    process.wait(timeout=MATCH_SECONDS)
                except subprocess.TimeoutExpired:
                    deadline_reached = True
                    process.send_signal(signal.SIGINT)
                    with contextlib.suppress(subprocess.TimeoutExpired):
                        process.wait(timeout=STOP_SECONDS)
                    kill_match_group(process)
                    process.wait()
            except KeyboardInterrupt:
                kill_match_group(process)
                raise
    return process.returncode, deadline_reached, time.monotonic() - started


def finish_kind(reason):
    if isinstance(reason, str):
        if NORMAL_FINISH.fullmatch(reason):
            return "normal"
        if LOSS_ON_TIME.fullmatch(reason):
            return "time_forfeit"
    return "abnormal"


def valid_diagnostics(lines):
    if len(lines) != len(DIAGNOSTICS):
        return False
    info, position, moves = (shape.fullmatch(line) for shape, line in zip(DIAGNOSTICS, lines))
    if not (info and position and moves):
        return False
    try:
        return chess.Board(position[1]).is_valid()
    except ValueError:
        return False


def unexpected_output(report, raw):
    report["unexpected"] += 1
    if len(report["unexpected_examples"]) < 5:
        report["unexpected_examples"].append(raw)


def read_log(path, report):
    terminations = collections.Counter()
    events = {}
    finish_reasons = []
    finished_kinds = {}
    console_finishes = {}
    losses_on_time = set()

    lines = path.read_text(errors="replace").split("\n")
    next_line = 0
    for index, raw in enumerate(lines):
        if index < next_line:
            continue
        # The pinned logger prints weekly diagnostic and console lines without colour.
        line = raw.rstrip("\r")
        warning = PV_WARNING.fullmatch(line)
        if warning:
            end = index + 1 + len(DIAGNOSTICS)
            if valid_diagnostics([detail.rstrip("\r") for detail in lines[index + 1:end]]):
                report[WARNING_COUNTS[warning[1]]] += 1
                next_line = end
                continue
        console = CONSOLE_FINISH.fullmatch(line)
        if console:
            number = int(console[1])
            kind = finish_kind(console[3])
            if kind == "time_forfeit":
                losses_on_time.add(number)
            if number in console_finishes:
                unexpected_output(report, raw)
            else:
                console_finishes[number] = (console[2], kind, raw)
            continue
        if any(shape.fullmatch(line) for shape in CONSOLE):
            continue
        try:
            event = json.loads(line)
        except ValueError:
            event = {}
        kind = event.get("event") if isinstance(event, dict) else None
        if not isinstance(kind, str) or kind not in EVENT_KINDS:
            unexpected_output(report, raw)
            continue
        if kind in PASSIVE_EVENTS:
            continue
        if kind == GAME_ABORTED:
            terminations["interrupted"] += 1
            number = event.get("game")
            if type(number) is int and finish_kind(event.get("reason")) == "time_forfeit":
                losses_on_time.add(number)
            continue
        if kind == TOURNAMENT_FINISHED:
            finish_reasons.append(event.get("reason"))
            continue
        if kind == GAME_FINISHED and (
            type(event.get("game")) is int and event["game"] not in events
            and type(event.get("plies")) is int and isinstance(event.get("result"), str)
            and isinstance(event.get("termination"), str)
        ):
            number = event["game"]
            events[number] = (event["plies"], event["result"])
            termination = event["termination"]
            reason_kind = finish_kind(event.get("reason"))
            if "time_forfeit" in (termination, reason_kind):
                losses_on_time.add(number)
                finished_kinds[number] = "time_forfeit"
            else:
                finished_kinds[number] = reason_kind if termination == "normal" else termination
            continue
        unexpected_output(report, raw)

    for number, (result, kind, raw) in console_finishes.items():
        if number not in events or events[number][1] != result:
            unexpected_output(report, raw)
        if kind != "normal" and finished_kinds.get(number) == "normal":
            finished_kinds[number] = kind
    terminations.update(finished_kinds.values())
    if losses_on_time:
        terminations["time_forfeit"] = len(losses_on_time)
    return terminations, events, finish_reasons


def pgn_mainline(record, result):
    headers = PGN_HEADERS.match(record)
    marker = RESULT_MARKER.search(record.rstrip())
    if RESULT_HEADER.findall(headers[0]) != [result] or not marker or marker[1] != result:
        return None

    # The replay library tolerates unfinished comments, extra result markers
    # and unrecognized tokens. Read the original mainline to check all three.
    depth = 0
    markers = []
    moves = []
    for match in PGN_TOKENS.finditer(record, headers.end()):
        token = match[0]
        if token in ("{", "}"):
            return None
        if token == "(":
            depth += 1
        elif token == ")":
            if not depth:
                return None
            depth -= 1
        elif not depth and token[0] not in "{%;" and not match["annotation"]:
            if token in ("1-0", "0-1", "1/2-1/2", "*"):
                markers.append((token, match.start()))
            else:
                moves.append(token)
    if depth == 0 and markers == [(result, marker.start(1))]:
        return moves


def matches_mainline(game, tokens):
    moves = list(game.mainline_moves())
    if len(moves) != len(tokens):
        return False
    position = game.board()
    try:
        for token, move in zip(tokens, moves):
            if position.parse_san(token) != move or not position.is_legal(move):
                return False
            position.push(move)
    except ValueError:
        return False
    return True


def replay_pgn(path, events):
    game_ids = set()
    terminations = collections.Counter()
    replay_errors = 0
    if not path.exists():
        return game_ids, terminations, replay_errors
    # Fastchess begins every record with Event and writes the result as its last token.
    preamble, *records = re.split(r"(?m)(?=^\[Event )", path.read_text(errors="replace"))
    replay_errors += bool(preamble.strip())
    for record in records:
        stream = io.StringIO(record)
        game = chess.pgn.read_game(stream)
        if game is None:
            replay_errors += 1
            continue
        terminations[game.headers.get("Termination", "missing")] += 1
        game_id = game.headers.get("GameId", "")
        if not game_id.isascii() or not game_id.isdecimal() or game.errors:
            replay_errors += 1
            continue
        number = int(game_id)
        if number in game_ids:
            replay_errors += 1
            continue
        game_ids.add(number)
        result = game.headers["Result"]
        tokens = pgn_mainline(record, result)
        if (tokens is not None and not stream.read().strip()
                and events.get(number) == (len(tokens), result) and matches_mainline(game, tokens)):
            continue
        replay_errors += 1
    return game_ids, terminations, replay_errors


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    fastchess = Path(sys.argv[1]).resolve(strict=True)
    evidence = Path(sys.argv[2]).resolve()
    evidence.mkdir()
    root = Path(__file__).resolve().parent.parent
    subprocess.run(["cargo", "build", "--locked", "--release", "-p", "fisher"], cwd=root, check=True)

    fisher = root / "target/release/fisher"
    openings = root / "strength/openings.epd"
    cores = runner_cores()
    concurrency = max(1, cores // 2)
    cpu = subprocess.check_output(
        ["lscpu"] if sys.platform == "linux" else ["sysctl", "-n", "machdep.cpu.brand_string"],
        text=True,
    )
    (evidence / "runner.txt").write_text(
        f"Available cores: {cores}\nRunner image: {os.getenv('ImageOS', 'local')} "
        f"{os.getenv('ImageVersion', '')}\n{platform.platform()}\n{cpu}"
    )
    version = subprocess.check_output([str(fastchess), "--version"], text=True)
    (evidence / "fastchess-version.txt").write_text(version)
    print(f"Playing {GAME_COUNT} games at concurrency {concurrency}", flush=True)
    command = [
        str(fastchess), "-engine", f"cmd={fisher}", "name=fisher-a",
        "-engine", f"cmd={fisher}", "name=fisher-b",
        "-each", "proto=uci", "tc=10/1", "timemargin=0",
        "-openings", f"file={openings}", "format=epd", "order=sequential",
        "-rounds", str(GAME_COUNT // 2), "-games", "2", "-concurrency", str(concurrency),
        "-pgnout", "file=games.pgn", "append=false", "timeleft=true", "latency=true",
        "-events", "file=-", "info=false", "-autosaveinterval", "0", "-ratinginterval", "0",
    ]
    (evidence / "command.sh").write_text(shlex.join(command) + "\n")
    status, deadline_reached, duration = run_match(command, evidence)
    report = {"repetition_warnings": 0, "fifty_move_warnings": 0, "unexpected": 0, "unexpected_examples": []}
    terminations, events, finish_reasons = read_log(evidence / "fastchess.log", report)
    pgn_ids, pgn_terminations, replay_errors = replay_pgn(evidence / "games.pgn", events)
    finished = len(events)
    abnormal = finished - terminations["normal"]
    summary = [
        f"Games finished: {finished} of {GAME_COUNT}",
        f"Abnormal endings: {abnormal}",
        f"Losses on time: {terminations['time_forfeit']}",
        f"Interrupted games: {terminations['interrupted']}",
        f"PGN games: {sum(pgn_terminations.values())}",
        f"PGN replay or record errors: {replay_errors}",
        f"Exact game IDs in log and PGN: {events.keys() == pgn_ids == IDS}",
        f"Tournament finish reasons: {finish_reasons}",
        f"Unexpected output lines: {report['unexpected']}",
        f"Repetition warnings: {report['repetition_warnings']}",
        f"Fifty-move warnings: {report['fifty_move_warnings']}",
        f"Terminations by kind: {dict(terminations)}",
        f"Match duration: {duration:.2f} seconds",
        f"Match deadline reached ({MATCH_SECONDS} seconds): {'yes' if deadline_reached else 'no'}",
        f"fastchess exit status: {status}",
    ]
    if report["unexpected_examples"]:
        summary.extend(["First unexpected output lines:", *report["unexpected_examples"]])
    output = "\n".join(summary) + "\n"
    (evidence / "summary.txt").write_text(output)
    print(output, end="")
    passed = (
        status == 0 and not deadline_reached and not abnormal and not terminations["time_forfeit"]
        and not terminations["interrupted"] and not report["unexpected"]
        and not replay_errors and pgn_terminations == {"normal": GAME_COUNT}
        and events.keys() == pgn_ids == IDS and finish_reasons == ["completed"]
    )
    return 0 if passed else 1


if __name__ == "__main__":
    sys.exit(main())
