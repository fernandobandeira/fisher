#!/usr/bin/env python3
"""Focused fixtures. Run with the PGN replay library installed as in the workflow."""
import contextlib
import importlib.machinery
import importlib.util
import io
import json
import os
import platform
from pathlib import Path
import re
import select
import signal
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch


ROOT = Path(__file__).resolve().parent.parent
LOADER = importlib.machinery.SourceFileLoader("clock_match", str(ROOT / "scripts/check-clock-match"))
MATCH = importlib.util.module_from_spec(importlib.util.spec_from_loader(LOADER.name, LOADER))
with patch.object(sys, "dont_write_bytecode", True):
    LOADER.exec_module(MATCH)

# Run 45683425250, first warning. The fifty-move warning and empty history
# use the alternate forms from d7b47e8 match.cpp:56–63 and 798–808.
REPETITION = "Warning; PV continues after threefold repetition - move d7c6 from fisher-a"
FIFTY_MOVE = "Warning; PV continues after fifty-move rule - move d7c6 from fisher-a"
DIAGNOSTICS = (
    "Info; info depth 4 multipv 1 score cp -200 nodes 134657 nps 8416062 time 16 pv c6d7 e4f5 d7c6 f5c8",
    "Position; fen r1bqkbnr/pp1pppp1/2n4p/2p5/2P2P2/4P3/PP1P2PP/RNBQKBNR w KQkq - 0 4",
    "Moves; c6d7 e4f5 d7c6",
)
# Reduced from the GameId 1 record and finish event of run 45683425250.
# Keep its starting FEN, first two plies and result.
PGN = (
    '[Event "Fastchess Tournament"]\n[GameId "1"]\n[Result "1/2-1/2"]\n'
    '[FEN "r1bqkbnr/pp1pppp1/2n4p/2p5/2P2P2/4P3/PP1P2PP/RNBQKBNR w KQkq - 0 4"]\n'
    '[Termination "normal"]\n\n4. Na3 e5 1/2-1/2\n'
)
FINISH = {
    "event": "game_finished", "game": 1, "plies": 2, "result": "1/2-1/2",
    "termination": "normal", "reason": "Draw by 3-fold repetition",
}
# Run 45683651168, fastchess.log. The two totals of 290 include these aborts.
ABORTS = (
    '{"event":"game_aborted","game":593,"reason":"White loses on time (202ms overrun)"}',
    '{"event":"game_aborted","game":594,"reason":"White loses on time (202ms overrun)"}',
)


class ClockMatchTests(unittest.TestCase):
    def setUp(self):
        temporary = tempfile.TemporaryDirectory()
        self.addCleanup(temporary.cleanup)
        self.directory = Path(temporary.name)

    def read_log(self, *lines):
        log = self.directory / "fastchess.log"
        log.write_text("\n".join(lines))
        report = {"repetition_warnings": 0, "fifty_move_warnings": 0,
                  "unexpected": 0, "unexpected_examples": []}
        terminations, _, _ = MATCH.read_log(log, report)
        return terminations, report

    def verify_match(self, *lines, finish=None, pgn=PGN):
        evidence = Path(tempfile.mkdtemp(dir=self.directory)) / "match"

        def stand_in(command, output):
            (output / "fastchess.log").write_text("\n".join((
                *lines, json.dumps(FINISH if finish is None else finish),
                '{"event":"tournament_finished","reason":"completed"}',
            )))
            (output / "games.pgn").write_text(pgn)
            return 0, False, 0

        with patch.object(sys, "argv", ["check-clock-match", __file__, str(evidence)]), \
                patch.multiple(MATCH, GAME_COUNT=1, IDS={1}, run_match=stand_in), \
                patch.object(MATCH, "runner_cores", return_value=2), \
                patch.object(platform, "platform", return_value="fixture"), \
                patch.object(subprocess, "run"), \
                patch.object(subprocess, "check_output", return_value="fixture\n"), \
                contextlib.redirect_stdout(io.StringIO()):
            verdict = MATCH.main()
        summary = (evidence / "summary.txt").read_text()
        return verdict, summary

    def test_both_exact_warnings_pass_and_are_counted(self):
        verdict, summary = self.verify_match(REPETITION, *DIAGNOSTICS, FIFTY_MOVE, *DIAGNOSTICS)
        self.assertEqual(verdict, 0, summary)
        self.assertIn("Repetition warnings: 1\n", summary)
        self.assertIn("Fifty-move warnings: 1\n", summary)

    def test_warnings_reject_invalid_positions(self):
        info, _, moves = DIAGNOSTICS
        for warning in (REPETITION, FIFTY_MOVE):
            with self.subTest(warning=warning):
                verdict, _ = self.verify_match(warning, info, "Position; fen / w - - 0 1", moves)
                self.assertEqual(verdict, 1, "invalid FEN passed the match")

    def test_warnings_reject_colour_escapes(self):
        # Logger::print at d7b47e8 writes these groups verbatim, and neither
        # archived match contains ESC. The red/reset pair from compliance.hpp
        # belongs to the separate compliance command, even around a whole line.
        info, position, moves = DIAGNOSTICS
        for warning in (REPETITION, FIFTY_MOVE):
            for line in (
                ("embedded warning", warning[:29] + "\x1b[1;31m" + warning[29:],
                 info, position, moves),
                ("wrapped warning", "\x1b[1;31m" + warning + "\x1b[0m", info, position, moves),
                ("embedded detail", warning, info.replace("depth", "de\x1b[1;31mpth"), position, moves),
            ):
                with self.subTest(warning=warning, case=line[0]):
                    verdict, _ = self.verify_match(*line[1:])
                    self.assertEqual(verdict, 1, "colour escape passed in a warning group")

    def test_other_warnings_fail(self):
        for warning in (
            FIFTY_MOVE + " extra",
            FIFTY_MOVE.replace("fisher-a", "fisher-c"),
            FIFTY_MOVE.replace("d7c6", "d7c9"),
            FIFTY_MOVE.replace("after fifty", "after the fifty"),
            "Warning; Illegal move a1a8 played by fisher-a",
        ):
            with self.subTest(warning=warning):
                _, report = self.read_log(warning, *DIAGNOSTICS)
                self.assertGreater(report["unexpected"], 0, "unrecognized warning was accepted")

    def test_losses_on_time_still_fail(self):
        verdict, summary = self.verify_match(finish=dict(FINISH, termination="time_forfeit"))
        self.assertEqual(verdict, 1, summary)
        self.assertIn("Losses on time: 1\n", summary)

    def test_finish_faults_cannot_be_hidden_by_normal_termination(self):
        timeout = "White loses on time (202ms overrun)"
        for reason in (timeout, "White makes an illegal move", "Black disconnects", "Game interrupted"):
            for source in ("console", "event", "both"):
                with self.subTest(reason=reason, source=source):
                    console = f"Finished game 1 (fisher-a vs fisher-b): 1/2-1/2 {{{reason}}}"
                    lines = (console,) if source in ("console", "both") else ()
                    finish = dict(FINISH, reason=reason) if source in ("event", "both") else FINISH
                    verdict, summary = self.verify_match(REPETITION, *DIAGNOSTICS, *lines, finish=finish)
                    self.assertEqual(verdict, 1, f"{source} fault passed: {reason}")
                    if reason == timeout:
                        self.assertIn("Losses on time: 1\n", summary)

    def test_console_result_must_agree_with_finish_event(self):
        for result, expected in (("1/2-1/2", 0), ("0-1", 1)):
            with self.subTest(result=result):
                verdict, _ = self.verify_match(
                    FIFTY_MOVE, *DIAGNOSTICS,
                    f"Finished game 1 (fisher-a vs fisher-b): {result} {{Draw by 3-fold repetition}}",
                )
                self.assertEqual(verdict, expected, "console result disagrees with finish event")

    def test_abnormal_finish_still_fails(self):
        verdict, summary = self.verify_match(finish=dict(FINISH, termination="crash"))
        self.assertEqual(verdict, 1, summary)
        self.assertIn("Abnormal endings: 1\n", summary)

    def test_illegal_replay_still_fails(self):
        with contextlib.redirect_stderr(io.StringIO()):
            verdict, summary = self.verify_match(pgn=PGN.replace("Na3", "Qa8"))
        self.assertEqual(verdict, 1, summary)
        self.assertIn("PGN replay or record errors: 1\n", summary)

    def test_unrecognized_mainline_token_fails_replay(self):
        verdict, summary = self.verify_match()
        self.assertEqual(verdict, 0, summary)
        verdict, summary = self.verify_match(pgn=PGN.replace("Na3 e5", "Na3 e5 Qz9"))
        self.assertEqual(verdict, 1, "Qz9 was skipped during replay")
        self.assertIn("PGN replay or record errors: 1\n", summary)

    def test_empty_history_requires_its_space(self):
        for history, unexpected in (("Moves; ", 0), ("Moves;", 1), ("Moves;  ", 1)):
            with self.subTest(history=history):
                _, report = self.read_log(REPETITION, *DIAGNOSTICS[:2], history)
                self.assertEqual(bool(report["unexpected"]), bool(unexpected), repr(history))

    def run_process_fixture(self, parent_exit):
        # Grandchild readiness proves the process tree exists before simulated
        # deadlines. The grace case releases the parent through stdin.
        command = [sys.executable, "-c", """
import os, signal, sys
signal.signal(signal.SIGINT, signal.SIG_DFL if sys.argv[1] == "SIGINT" else signal.SIG_IGN)
if os.fork() == 0:
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    child = os.getpid()
    if os.fork() == 0:
        print(child, os.getpid(), flush=True)
    while True:
        signal.pause()
sys.stdin.buffer.read(1)
""", parent_exit]
        popen = subprocess.Popen
        waits = []
        signals = []
        hang_timeout = 30

        def stop(pid):
            with contextlib.suppress(ProcessLookupError):
                os.kill(pid, signal.SIGKILL)

        def start(args, **options):
            options.update(stdin=subprocess.PIPE, stdout=subprocess.PIPE)
            process = popen(args, **options)
            original_wait = process.wait
            self.addCleanup(process.stdout.close)
            self.addCleanup(process.stdin.close)
            self.addCleanup(original_wait, timeout=hang_timeout)
            self.addCleanup(stop, process.pid)
            self.assertTrue(select.select([process.stdout], [], [], hang_timeout)[0],
                            "stand-in did not signal readiness")
            for pid in map(int, process.stdout.readline().split()):
                self.addCleanup(stop, pid)
            self.process_output = os.fdopen(os.dup(process.stdout.fileno()), "rb")
            self.addCleanup(self.process_output.close)
            original_send_signal = process.send_signal

            def wait(timeout=None):
                if timeout is None:
                    return original_wait(timeout=hang_timeout)
                waits.append(timeout)
                if waits == [3600]:
                    if parent_exit == "Ctrl-C":
                        raise KeyboardInterrupt
                    raise subprocess.TimeoutExpired(args, timeout)
                self.assertEqual(waits, [3600, 10])
                if parent_exit == "stays":
                    raise subprocess.TimeoutExpired(args, timeout)
                if parent_exit == "grace":
                    process.stdin.write(b"x")
                    process.stdin.flush()
                return original_wait(timeout=hang_timeout)

            def send_signal(signum):
                signals.append(signum)
                original_send_signal(signum)

            process.wait = wait
            process.send_signal = send_signal
            return process

        with patch.object(subprocess, "Popen", side_effect=start), \
                patch.object(os, "killpg", wraps=os.killpg) as kill_group:
            if parent_exit == "Ctrl-C":
                with self.assertRaises(KeyboardInterrupt):
                    MATCH.run_match(command, self.directory)
                self.assertEqual(waits, [3600])
            else:
                status, deadline, _ = MATCH.run_match(command, self.directory)
                self.assertTrue(deadline)
                self.assertEqual(status, {"stays": -signal.SIGKILL, "grace": 0, "SIGINT": -signal.SIGINT}[parent_exit])
                self.assertEqual(waits, [3600, 10])

        timeout = hang_timeout if kill_group.called else 0
        self.assertTrue(select.select([self.process_output], [], [], timeout)[0],
                        f"grandchild kept the pipe open after {parent_exit}")
        self.assertEqual(self.process_output.read(1), b"")
        self.assertEqual(signals, [] if parent_exit == "Ctrl-C" else [signal.SIGINT])

    def test_forced_cleanup_kills_the_descendant(self):
        self.run_process_fixture("stays")

    def test_cleanup_after_parent_exits_during_grace(self):
        self.run_process_fixture("grace")

    def test_cleanup_after_parent_exits_on_sigint(self):
        self.run_process_fixture("SIGINT")

    def test_ctrl_c_cleans_up_and_reraises(self):
        self.run_process_fixture("Ctrl-C")

    def test_workflow_leaves_time_for_evidence(self):
        workflow = (ROOT / ".github/workflows/clock-match.yml").read_text()
        job_minutes = int(re.search(r"(?m)^    timeout-minutes: (\d+)$", workflow)[1])
        steps = re.split(r"(?m)^      - ", workflow.split("    steps:\n", 1)[1])[1:]
        self.assertEqual(len(steps), 7)
        self.assertEqual(MATCH.MATCH_SECONDS, 3600, "approved Arm B play deadline")
        self.assertEqual(MATCH.STOP_SECONDS, 10, "grace after SIGINT")
        self.assertIn("if: always()", steps[-1], "upload must run after failure")
        self.assertIn("actions/upload-artifact@", steps[-1])
        limits = []
        for step in steps:
            limit = re.search(r"(?m)^        timeout-minutes: (\d+)$", step)
            self.assertIsNotNone(limit, step.splitlines()[0] + " needs a step timeout")
            limits.append(60 * int(limit[1]))
        self.assertEqual(limits[:5], [180] * 5)
        self.assertEqual(limits[-1], 180)
        self.assertIn("check-clock-match", steps[5])
        self.assertGreater(limits[5], 3600 + 10, "leave time for build and replay")
        self.assertGreater(job_minutes * 60, sum(limits), "all step limits must fit with time to spare")

    def test_pgn_requires_explicit_header_and_one_top_level_result(self):
        cases = {
            "complete": (PGN, 0),
            "closed comment and variation": (
                PGN.replace("Na3 e5", "Na3 {comment 0-1} (4. Nf3) e5"), 0),
            "missing Result header": (PGN.replace('[Result "1/2-1/2"]\n', ""), 1),
            "result inside unfinished comment": (PGN.replace("e5 1/2-1/2", "e5 { 1/2-1/2"), 1),
            "unfinished comment after result": (PGN.rstrip() + " { trailing comment\n1/2-1/2", 1),
            "result inside line comment": (PGN.replace("e5 1/2-1/2", "e5 ; 1/2-1/2"), 1),
            "hidden final token after a result": (PGN.rstrip() + " ; 1/2-1/2", 1),
            "result inside unfinished variation": (PGN.replace("e5 1/2-1/2", "e5 (4... d5 1/2-1/2"), 1),
            "duplicate result": (PGN.replace("e5 1/2-1/2", "e5 0-1 1/2-1/2"), 1),
            "duplicate result on separated line": (PGN + "\n1/2-1/2\n", 1),
            "unfinished marker before result": (PGN.replace("e5 1/2-1/2", "e5 * 1/2-1/2"), 1),
            "mismatched result": (PGN.replace("e5 1/2-1/2", "e5 1-0"), 1),
        }
        path = self.directory / "games.pgn"
        for case, (record, expected) in cases.items():
            with self.subTest(case=case), contextlib.redirect_stderr(io.StringIO()):
                path.write_text(record)
                _, _, errors = MATCH.replay_pgn(path, {1: (2, "1/2-1/2")})
                self.assertEqual(errors, expected, case)
        path.write_text(PGN)
        for finish in ((1, "1/2-1/2"), (2, "1-0")):
            with self.subTest(finish=finish):
                _, _, errors = MATCH.replay_pgn(path, {1: finish})
                self.assertEqual(errors, 1, "finish event disagrees with record")

    def test_diagnostics_must_be_a_complete_ordered_group(self):
        info, position, moves = DIAGNOSTICS
        cases = {
            "complete": ((REPETITION, info, position, moves), False),
            "orphaned": ((info, position, moves), True),
            "incomplete at end of log": ((REPETITION, info, position), True),
            "reordered": ((REPETITION, info, moves, position), True),
            "interleaved event": ((REPETITION, info, json.dumps(FINISH), position, moves), True),
        }
        for case, (lines, unexpected) in cases.items():
            with self.subTest(case=case):
                _, report = self.read_log(*lines)
                self.assertEqual(bool(report["unexpected"]), unexpected, case)
                self.assertEqual(report["repetition_warnings"], int(not unexpected), case)

    def test_archived_aborted_losses_keep_both_counts(self):
        verdict, summary = self.verify_match(*ABORTS)
        self.assertIn("Losses on time: 2\n", summary)
        self.assertIn("Interrupted games: 2\n", summary)
        self.assertEqual(verdict, 1, summary)

    def test_other_abort_reasons_only_count_as_interruptions(self):
        terminations, _ = self.read_log(
            '{"event":"game_aborted","game":595,"reason":"interrupted"}',
            '{"event":"game_aborted","game":596,"reason":null}',
        )
        self.assertEqual(terminations["interrupted"], 2)
        self.assertEqual(terminations["time_forfeit"], 0)

    def test_evidence_page_lists_recognized_events(self):
        page = (ROOT / "docs/guardrails/behaviour-evidence.md").read_text()
        section = page.split("## Real-clock match", 1)[1]
        documented = set(re.findall(r"`(move|[a-z]+_[a-z]+)`", section))
        self.assertEqual(documented, MATCH.EVENT_KINDS)


if __name__ == "__main__":
    unittest.main()
