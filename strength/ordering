#!/usr/bin/env python3
"""Draw the D64 sample or measure two revisions on its fixed depths."""

import argparse
from contextlib import contextmanager
import csv
from fractions import Fraction
from hashlib import sha256
import json
from math import ceil
import os
from pathlib import Path
from platform import system
from random import Random
import re
from selectors import DefaultSelector, EVENT_READ
import subprocess
import sys
from statistics import median
from tempfile import TemporaryDirectory
from time import perf_counter, perf_counter_ns

ROOT = Path(__file__).resolve().parents[1]
SAMPLE = ROOT / "strength/ordering-sample.tsv"
THRESHOLD = ROOT / "strength/ordering-threshold.tsv"
POSITIONS = 300
SEED = 20261127
TIMED_PAIRS = 6
CALIBRATIONS = 5
SEARCH_TIMEOUT = 120
FINISHED_DEPTH = re.compile(rb"info depth (\d+)(?: multipv 1)? score (?:cp|mate) -?\d+ nodes (\d+) ")


def revision(ref):
    return subprocess.check_output(
        ["git", "rev-parse", "--verify", "--end-of-options", f"{ref}^{{commit}}"],
        cwd=ROOT, text=True,
    ).strip()


def toolchain(commit):
    import tomllib

    manifest = subprocess.check_output(
        ["git", "show", f"{commit}:rust-toolchain.toml"], cwd=ROOT, text=True,
    )
    return tomllib.loads(manifest)["toolchain"]["channel"]


def prepare_rust(base, measured):
    channels = dict.fromkeys(toolchain(revision(ref)) for ref in (base, measured or base))
    environment = dict(os.environ, RUSTUP_HOME=os.environ["ORDERING_RUSTUP_HOME"])
    for channel in channels:
        subprocess.run(
            ["rustup", "toolchain", "install", channel, "--profile", "minimal", "--no-self-update"],
            env=environment, check=True,
        )


def build(commit, source):
    source.mkdir()
    archive = source / "source.tar"
    subprocess.run(["git", "archive", "-o", archive, commit], cwd=ROOT, check=True)
    subprocess.run(["tar", "-xf", archive], cwd=source, check=True)
    target = source / "target"
    command = ["cargo", "build", "--locked", "--release", "-p", "fisher", "--target-dir", target]
    environment = os.environ.copy()
    if rustup_home := environment.get("ORDERING_RUSTUP_HOME"):
        environment["RUSTUP_HOME"] = rustup_home
        command[:0] = ["rustup", "run", toolchain(commit)]
    subprocess.run(
        command, cwd=source, env=environment, stdout=sys.stderr, check=True,
    )
    return target / "release/fisher"


class Engine:
    def __init__(self, process, readable):
        self.process = process
        self.readable = readable
        self.pending = b""

    def send(self, commands):
        self.process.stdin.write(commands.encode("ascii"))
        self.process.stdin.flush()

    def responses(self):
        deadline = perf_counter() + SEARCH_TIMEOUT
        while True:
            line, separator, rest = self.pending.partition(b"\n")
            if separator:
                self.pending = rest
                yield line.rstrip(b"\r")
                continue
            remaining = deadline - perf_counter()
            if remaining <= 0 or not self.readable.select(remaining):
                raise ValueError(f"{self.process.args[0]}: timed out waiting for UCI")
            output = os.read(self.process.stdout.fileno(), 8192)
            if not output:
                raise ValueError(f"{self.process.args[0]}: exited while responding over UCI")
            self.pending += output

    def wait_for(self, response):
        for line in self.responses():
            if line == response:
                return

    def search(self, fen, limit):
        self.send("ucinewgame\nisready\n")
        self.wait_for(b"readyok")
        self.send(f"position fen {fen}\ngo {limit}\n")
        finished = None
        for line in self.responses():
            if line.startswith((b"info string position rejected:", b"info string go rejected:")):
                raise ValueError(f"{fen}: {line.decode('ascii', errors='replace')}")
            if match := FINISHED_DEPTH.match(line):
                finished = tuple(map(int, match.groups()))
            if line.startswith(b"bestmove "):
                if finished is None or line == b"bestmove 0000" or min(finished) < 1:
                    raise ValueError(f"{fen}: no finished depth at {limit}")
                return finished


@contextmanager
def engine(binary):
    with subprocess.Popen(
        [binary], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
    ) as process, DefaultSelector() as readable:
        try:
            readable.register(process.stdout, EVENT_READ)
            session = Engine(process, readable)
            session.send("uci\n")
            session.wait_for(b"uciok")
            yield session
            session.send("quit\n")
            if process.wait(timeout=SEARCH_TIMEOUT):
                raise ValueError(f"{binary}: failed to exit cleanly")
        finally:
            if process.poll() is None:
                process.kill()


def draw_positions(games, seed):
    try:
        import chess
    except ImportError:
        raise ValueError("Install python-chess as described in strength/README.md") from None

    generator = Random(seed)
    order = list(range(len(games)))
    generator.shuffle(order)
    seen = set()
    positions = []
    for index in order:
        _, opening, _, moves, _, _ = games[index]
        part = len(positions) % 3
        first = len(moves) * part // 3 + 1
        last = len(moves) * (part + 1) // 3
        if first > last:
            continue
        ply = generator.randrange(first, last + 1)
        position = chess.Board(opening)
        for move in moves[:ply]:
            position.push_uci(move)
        fen = position.fen(en_passant="fen")
        if fen in seen or not position.legal_moves:
            continue
        positions.append((fen, index + 1, ply))
        seen.add(fen)
        if len(positions) == POSITIONS:
            return positions
    raise ValueError(f"the games yielded only {len(positions)} positions")


def draw(args, directory):
    source = args.games.read_bytes()
    games = [json.loads(line) for line in source.splitlines()]
    if len(games) != 4000:
        raise ValueError("expected the 4,000 joined conditions-3 games")
    positions = draw_positions(games, args.seed)
    commit = revision(args.revision)
    binary = build(commit, directory / "depths")
    with engine(binary) as session:
        rows = [
            (fen, session.search(fen, "nodes 1000000")[0], game, ply)
            for fen, game, ply in positions
        ]

    lines = [
        f"# Draw date: {args.date}",
        "# Source: conditions 3, 2026-11-26, 5c5d6cf vs 8b9c254, 4,000 joined games",
        f"# Run: https://github.com/fernandobandeira/fisher/actions/runs/{args.run}",
        f"# Joined games.jsonl SHA-256: {sha256(source).hexdigest()}",
        f"# Seed: {args.seed}",
        "# Generator: MT19937, CPython 3.9.6 random.Random.shuffle and randrange",
        "# Shuffle the canonical joined game order. Use at most one position per game.",
        "# Rotate through thirds of the plies after the opening, using floor boundaries.",
        "# Draw one ply uniformly within its third. Skip empty thirds, terminal positions",
        "# and duplicate canonical FENs without advancing the rotation. Keep 100 per third.",
        f"# Depth: last finished depth at go nodes 1000000 on {commit}",
        "# Columns: FEN, depth, one-based game number in games.jsonl, ply after the opening",
    ]
    lines.extend("\t".join(map(str, row)) for row in rows)
    sys.stdout.buffer.write(("\n".join(lines) + "\n").encode("ascii"))


def read_sample():
    positions = []
    for line in SAMPLE.read_text(encoding="ascii").splitlines():
        if line.startswith("#"):
            continue
        fen, depth, _, _ = line.split("\t")
        if len(fen.split()) != 6 or not 1 <= int(depth) <= 255:
            raise ValueError(f"invalid sample row: {line!r}")
        positions.append((fen, int(depth)))
    if len(positions) != POSITIONS or len({fen for fen, _ in positions}) != POSITIONS:
        raise ValueError(f"expected {POSITIONS} distinct FENs in {SAMPLE}")
    return positions


def run_sample(binary, positions):
    counts = []
    with engine(binary) as session:
        started = perf_counter_ns()
        for fen, depth in positions:
            finished_depth, nodes = session.search(fen, f"depth {depth}")
            if finished_depth != depth:
                raise ValueError(f"{fen}: wanted depth {depth}, finished depth {finished_depth}")
            counts.append(nodes)
        elapsed = perf_counter_ns() - started
    return counts, elapsed


def cpu_model():
    if system() == "Darwin":
        return subprocess.check_output(["sysctl", "-n", "machdep.cpu.brand_string"], text=True).strip()
    output = subprocess.check_output(["lscpu"], env=dict(os.environ, LC_ALL="C"), text=True)
    for line in output.splitlines():
        label, _, value = line.partition(":")
        if label == "Model name":
            return value.strip()
    raise ValueError("lscpu did not report the CPU model")


def report_threshold(model):
    with THRESHOLD.open(encoding="utf-8", newline="") as stream:
        records = list(csv.DictReader(stream, delimiter="\t"))
    if not records:
        print("Recorded time threshold: pending (CPU model: pending)", flush=True)
        return
    if len(records) != 1:
        raise ValueError(f"expected one time threshold in {THRESHOLD}")
    record = records[0]
    if not re.fullmatch(r"[0-9]+", record["percent"] or "") or not all(
        record[field] for field in ("runner", "cpu_model", "date", "run_url")
    ):
        raise ValueError(f"incomplete time threshold in {THRESHOLD}")
    print(f"Recorded time threshold: {record['percent']}% (CPU model: {record['cpu_model']})", flush=True)
    if model != record["cpu_model"]:
        print("CPU model differs from the model in the recorded D64 threshold. "
              "See strength/README.md for the time verdict rule.", flush=True)


def compare(revisions, binaries, positions):
    warmup = [run_sample(binary, positions)[0] for binary in binaries]
    if revisions[0] == revisions[1] and warmup[0] != warmup[1]:
        raise ValueError("the two builds of the same revision gave different node counts")
    times = [[], []]
    for repeat in range(TIMED_PAIRS):
        for index in ((0, 1) if repeat % 2 == 0 else (1, 0)):
            counts, elapsed = run_sample(binaries[index], positions)
            if counts != warmup[index]:
                raise ValueError(f"{revisions[index]}: node counts changed between runs")
            times[index].append(elapsed)

    medians = [median(map(Fraction, samples)) for samples in times]
    for label, commit, counts, samples, middle in zip(
        ("Base", "Measured"), revisions, warmup, times, medians,
    ):
        readings = ", ".join(f"{sample / 1e9:.6f}" for sample in samples)
        print(f"{label} {commit}: {sum(counts)} nodes, {middle / 1e9:.6f} s median"
              f" ({readings} s)", flush=True)
    gap = 100 * (medians[1] - medians[0]) / medians[0]
    if gap <= -2:
        classification = "clear gain"
    elif gap > 2:
        classification = "clear fail"
    else:
        classification = "marginal"
    print(f"Measured time change: {float(gap):+.4f}% ({classification})", flush=True)
    return gap


def measure(base, measured, directory):
    model = cpu_model()
    print(f"CPU model: {model}", flush=True)
    if measured is not None:
        report_threshold(model)
    positions = read_sample()
    commits = (revision(base), revision(measured or base))
    binaries = [build(commit, directory / str(index)) for index, commit in enumerate(commits)]
    if measured is not None:
        compare(commits, binaries, positions)
        return

    gaps = []
    for repeat in range(CALIBRATIONS):
        print(f"Self-measurement {repeat + 1}/{CALIBRATIONS}", flush=True)
        gaps.append(abs(compare(commits, binaries, positions)))
    print(f"Largest absolute time difference: {float(max(gaps)):.4f}%")
    print(f"Time threshold (rounded up): {ceil(max(gaps))}%")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    draw_command = commands.add_parser("draw", help="write the sample from joined games.jsonl")
    draw_command.add_argument("games", type=Path)
    draw_command.add_argument("revision", help="revision that supplies the depths")
    draw_command.add_argument("--seed", type=int, default=SEED)
    draw_command.add_argument("--date", default="2026-11-27")
    draw_command.add_argument("--run", type=int, default=45876884742)
    comparison = commands.add_parser("measure", help="compare depths, node counts and time")
    comparison.add_argument("base")
    comparison.add_argument("measured")
    calibration = commands.add_parser("calibrate", help="time one revision against itself five times")
    calibration.add_argument("base")
    install = commands.add_parser("prepare-rust", help="install the pinned Rust channels for a hosted run")
    install.add_argument("base")
    install.add_argument("measured", nargs="?")
    args = parser.parse_args()

    try:
        if args.command == "prepare-rust":
            prepare_rust(args.base, args.measured)
            return
        with TemporaryDirectory(prefix="fisher-ordering-") as temporary:
            directory = Path(temporary)
            if args.command == "draw":
                draw(args, directory)
            else:
                measure(args.base, getattr(args, "measured", None), directory)
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        sys.exit(f"{parser.prog}: {error}")


if __name__ == "__main__":
    main()
