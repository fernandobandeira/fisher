#!/bin/sh
set -eu

cd "$(dirname "$0")/.."
if ! command -v cargo >/dev/null 2>&1; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

check() {
    step=$1
    fix=$2
    shift 2
    if output=$("$@" 2>&1); then
        printf '%s passed\n' "$step"
    else
        status=$?
        printf '%s\n%s failed. Run from the repo root: %s\n' "$output" "$step" "$fix" >&2
        exit "$status"
    fi
}

# A crate that does not inherit the workspace lints is not linted at all.
crates_inherit_lints() {
    missing=0
    for manifest in crates/*/Cargo.toml; do
        if ! tr -d ' \n' <"$manifest" | grep -qF '[lints]workspace=true'; then
            printf '%s does not inherit the workspace lints. Add a [lints] section with "workspace = true" to it.\n' "$manifest"
            missing=1
        fi
    done
    return "$missing"
}

cargo_deny_version=0.22.0
if [ "$(cargo deny --version 2>/dev/null)" != "cargo-deny $cargo_deny_version" ]; then
    echo "Install the CI version with: cargo install cargo-deny --version $cargo_deny_version --locked" >&2
    exit 1
fi

if ! python3 -Ic 'import sys; sys.exit(sys.version_info < (3, 9))'; then
    case "$(uname -s)" in
        Darwin) fix='brew install python' ;;
        *) fix='sudo apt-get install python3 python3-venv' ;;
    esac
    printf 'The fixtures need Python 3.9 or newer. Run: %s\n' "$fix" >&2
    exit 1
fi

check Format 'cargo fmt --all' cargo fmt --all -- --check
check Lints 'scripts/check' crates_inherit_lints
check 'Crate boundary fixtures' 'scripts/check-crate-boundaries --self-test' \
    scripts/check-crate-boundaries --self-test
check 'Crate source path fixtures' 'scripts/check-source-paths --self-test' \
    scripts/check-source-paths --self-test
check 'Guard-Change fixtures' 'scripts/check-guard-change --self-test' \
    scripts/check-guard-change --self-test
check 'Await merge fixtures' 'scripts/test-await-merge' scripts/test-await-merge
check 'Clock match fixtures' 'python3 -I scripts/run-clock-match-fixtures' \
    python3 -I scripts/run-clock-match-fixtures
check 'Ordering fixtures' 'python3 -I strength/test-ordering.py' \
    python3 -I strength/test-ordering.py
check 'Advisory database fixtures' 'scripts/test-advisory-db' scripts/test-advisory-db
check 'Clocked SPRT fixtures' 'scripts/test-clocked-sprt' scripts/test-clocked-sprt
check 'Hosted SPRT fixtures' 'scripts/test-hosted-sprt' scripts/test-hosted-sprt
check 'Crate boundaries' 'scripts/check-crate-boundaries' scripts/check-crate-boundaries
check 'Crate source paths' 'scripts/check-source-paths' scripts/check-source-paths
check Clippy 'cargo clippy --locked --workspace --all-targets --all-features -- -D warnings' \
    cargo clippy --locked --workspace --all-targets --all-features -- -D warnings
check Tests 'cargo test --locked --workspace' cargo test --locked --workspace
check Glossary 'cargo xtask glossary' cargo xtask glossary
check 'Crate interfaces' 'cargo xtask interfaces' cargo xtask interfaces

# Populate Cargo's registry and package cache for the offline dependency check.
check 'Locked dependencies' 'cargo fetch --locked' cargo fetch --locked
# Git hooks export paths for Fisher's checkout. The advisory database is a separate repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX \
    GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_SHALLOW_FILE
advisory_refresh=
if [ "${CI:-}" = true ]; then
    advisory_refresh=${FISHER_ADVISORY_DB_REFRESH_RESULT:-}
fi
if [ -z "$advisory_refresh" ]; then
    if [ "${CARGO_NET_OFFLINE:-false}" != true ] && scripts/check-advisory-db refresh; then
        advisory_refresh=success
    else
        advisory_refresh=failure
    fi
fi
scripts/check-advisory-db "$advisory_refresh"
check 'Dependency advisories and sources' 'cargo deny --locked --offline check -D warnings advisories sources' \
    cargo deny --locked --offline check -D warnings advisories sources
